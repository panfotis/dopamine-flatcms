{# Component: hero — rendered for every block of type `hero`. #}
<section class="hero" style="--align:{{ fields.align|default('center') }}">
  {% if fields.image %}
    <div class="hero-media">
      <img src="{{ img(fields.image, 1800) }}" alt="" fetchpriority="high"
           srcset="{{ img(fields.image, 900) }} 900w, {{ img(fields.image, 1800) }} 1800w"
           sizes="100vw">
    </div>
  {% endif %}

  <div class="wrap hero-body">
    <h1>{{ fields.heading }}</h1>
    {% if fields.subheading %}<p class="lede">{{ fields.subheading|nl2br }}</p>{% endif %}
    {% if fields.cta_label and fields.cta_url %}
      <p><a class="btn" href="{{ fields.cta_url }}">{{ fields.cta_label }}</a></p>
    {% endif %}
  </div>
</section>

<style>
  .hero{position:relative;padding:96px 0 88px;color:#fff;background:#12141a;overflow:hidden}
  .hero-media{position:absolute;inset:0}
  .hero-media img{width:100%;height:100%;object-fit:cover;opacity:.5}
  .hero-body{position:relative;text-align:var(--align);max-width:820px}
  .hero .lede{font-size:clamp(1.05rem,2vw,1.3rem);color:#e7e9ec;margin:0 0 1.6em}
  .hero:not(:has(.hero-media)){background:#12141a}
</style>
