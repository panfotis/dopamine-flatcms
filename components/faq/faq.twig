{# Component: faq — built from schema.yml and this file, with no registration
   step and no PHP anywhere. <details> does the disclosure natively, so there
   is nothing to ship for it. #}
<section class="faq">
  <div class="wrap">
    {% if fields.heading %}<h2>{{ fields.heading }}</h2>{% endif %}

    {% for item in fields.questions %}
      <details{{ loop.first and fields.open_first ? ' open' : '' }}>
        <summary>{{ item.question }}</summary>
        <div class="answer">{{ item.answer|raw }}</div>
      </details>
    {% endfor %}
  </div>
</section>

<style>
  .faq{padding:72px 0}
  .faq details{border-bottom:1px solid var(--line)}
  .faq summary{cursor:pointer;padding:18px 0;font-weight:600;list-style:none}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:'+';float:inline-end;color:var(--muted)}
  .faq details[open] summary::after{content:'−'}
  .faq .answer{padding:0 0 18px;color:var(--muted)}
</style>
