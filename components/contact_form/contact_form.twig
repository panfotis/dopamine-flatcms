{# Component: contact_form.

   The inputs come from the component's `form:` key, handed in by the entry
   point as `form_inputs` — the client cannot add, remove or retype one, the
   same rule that governs blocks.

   The page is `private: true`, so it is never edge-cached and the CSRF token in
   here is genuinely this visitor's. That is the whole reason the caching
   decision was made in Phase 0 rather than discovered now. #}
<section class="contact-form" id="{{ block.id }}">
  <div class="wrap">
    {% if form_sent|default(false) %}
      {# POST/redirect/GET landed here: refreshing does not resubmit. #}
      <div class="form-ok" role="status">
        <h2>{{ fields.heading }}</h2>
        <p>{{ fields.success }}</p>
      </div>
    {% else %}
      <h2>{{ fields.heading }}</h2>
      {% if fields.intro %}<p class="intro">{{ fields.intro|nl2br }}</p>{% endif %}

      {% if form_errors._|default('') %}
        <p class="form-err" role="alert">{{ form_errors._ }}</p>
      {% endif %}

      <form method="post" novalidate>
        <input type="hidden" name="csrf" value="{{ form_csrf }}">

        {# The honeypot. Hidden from people, not from bots — and off-screen
           rather than `type=hidden`, because a hidden input is the first thing
           a scripted submitter learns to skip. `tabindex=-1` and
           `autocomplete=off` keep it away from anyone using a keyboard or a
           password manager. #}
        <div class="hp" aria-hidden="true">
          <label for="{{ block.id }}-website">{{ ts('form.honeypot_label') }}</label>
          <input type="text" id="{{ block.id }}-website" name="website" tabindex="-1" autocomplete="off">
        </div>

        {% for name, input in form_inputs %}
          {% set id = block.id ~ '-' ~ name %}
          {% set err = form_errors[name]|default('') %}
          {% if input.type == 'radio' %}
            {# A group has no single input for a `for` to point at; the legend
               is the group's label and each option labels itself. #}
            <fieldset class="field radios{{ err ? ' has-error' : '' }}">
              <legend>
                {{ ts(input.label) }}{% if input.required %} <span aria-hidden="true">*</span>{% endif %}
              </legend>
              {% for value, label in input.options %}
                <label class="opt">
                  <input type="radio" name="{{ name }}" value="{{ value }}"
                         {{ form_values[name]|default('') == value ? 'checked' : '' }}
                         {{ input.required ? 'required' : '' }}>
                  {{ ts(label) }}
                </label>
              {% endfor %}
              {% if err %}<p class="err">{{ err }}</p>{% endif %}
            </fieldset>
          {% elseif input.type == 'checkbox' %}
            <div class="field check{{ err ? ' has-error' : '' }}">
              <label class="opt">
                <input type="checkbox" name="{{ name }}" value="1"
                       {{ form_values[name]|default('') ? 'checked' : '' }}
                       {{ input.required ? 'required' : '' }}>
                {{ ts(input.label) }}{% if input.required %} <span aria-hidden="true">*</span>{% endif %}
              </label>
              {% if err %}<p class="err">{{ err }}</p>{% endif %}
            </div>
          {% else %}
          <div class="field{{ err ? ' has-error' : '' }}">
            <label for="{{ id }}">
              {{ ts(input.label) }}{% if input.required %} <span aria-hidden="true">*</span>{% endif %}
            </label>
            {% if input.type == 'select' %}
              {# The first option carries an empty key and is the placeholder;
                 that is what lets `required` mean anything on a dropdown. #}
              <select id="{{ id }}" name="{{ name }}"
                      {{ input.required ? 'required' : '' }}
                      {{ err ? 'aria-invalid="true"' : '' }}>
                {% for value, label in input.options %}
                  <option value="{{ value }}"{{ form_values[name]|default('') == value ? ' selected' : '' }}>{{ ts(label) }}</option>
                {% endfor %}
              </select>
            {% elseif input.type == 'textarea' %}
              <textarea id="{{ id }}" name="{{ name }}" maxlength="{{ input.max }}"
                        {{ input.required ? 'required' : '' }}
                        {{ err ? 'aria-invalid="true"' : '' }}>{{ form_values[name]|default('') }}</textarea>
            {% else %}
              <input type="{{ input.type }}" id="{{ id }}" name="{{ name }}"
                     value="{{ form_values[name]|default('') }}" maxlength="{{ input.max }}"
                     {{ input.required ? 'required' : '' }}
                     {{ err ? 'aria-invalid="true"' : '' }}>
            {% endif %}
            {% if err %}<p class="err">{{ err }}</p>{% endif %}
          </div>
          {% endif %}
        {% endfor %}

        {% if fields.consent_text %}
          <div class="field consent{{ form_errors.consent|default('') ? ' has-error' : '' }}">
            <label>
              <input type="checkbox" name="consent" value="1" required>
              {{ fields.consent_text }}
            </label>
            {% if form_errors.consent|default('') %}<p class="err">{{ form_errors.consent }}</p>{% endif %}
          </div>
        {% endif %}

        {# Only when an admin switched it on *and* a key is configured. A
           toggle with no keys behaves as off rather than rendering a widget
           that cannot work. #}
        {% if fields.turnstile and turnstile_site_key|default('') %}
          <div class="cf-turnstile" data-sitekey="{{ turnstile_site_key }}"></div>
          <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
        {% endif %}

        <button class="btn" type="submit">{{ ts('form.send') }}</button>
      </form>

      {# The error re-render is a fresh page at scroll-top; if the form sits
         below the fold the visitor sees no reason it did not send. #}
      {% if form_errors|default({})|length %}
        <script>
          (function () {
            var root = document.getElementById('{{ block.id }}');
            var t = root.querySelector('.form-err, .has-error input, .has-error textarea, .has-error select');
            if (!t) return;
            t.scrollIntoView({ block: 'center' });
            if (t.matches('input, textarea, select')) t.focus({ preventScroll: true });
          })();
        </script>
      {% endif %}
    {% endif %}
  </div>
</section>

<style>
  .contact-form{padding:72px 0}
  .contact-form .intro{color:var(--muted);max-width:60ch}
  .contact-form form{max-width:560px;display:grid;gap:16px;margin-top:24px}
  .contact-form label{display:block;font-weight:600;font-size:14px;margin-bottom:5px}
  .contact-form input[type=text],.contact-form input[type=email],
  .contact-form input[type=tel],.contact-form textarea,.contact-form select{
    width:100%;padding:11px 13px;border:1px solid #cfd4da;border-radius:8px;font:inherit;color:inherit}
  .contact-form textarea{min-height:140px;resize:vertical}
  .contact-form .consent label{font-weight:400;font-size:14px;display:flex;gap:9px;align-items:flex-start}
  .contact-form .consent input{margin-top:3px}
  .contact-form .radios{border:0;padding:0;margin:0}
  .contact-form .radios legend{font-weight:600;font-size:14px;margin-bottom:5px;padding:0}
  .contact-form .opt{font-weight:400;display:flex;gap:9px;align-items:flex-start;margin:0 0 6px}
  .contact-form .opt input{margin-top:3px}
  .contact-form .err{color:#b4232a;font-size:13px;font-weight:600;margin:5px 0 0}
  .contact-form select{background:#fff;appearance:auto}
  .contact-form .has-error input,.contact-form .has-error textarea,
  .contact-form .has-error select{border-color:#b4232a}
  .contact-form .form-err{background:#fdeaea;border:1px solid #f3c4c4;color:#b4232a;
    padding:12px 16px;border-radius:8px}
  .contact-form .form-ok{background:#e7f6ee;border:1px solid #b7e2cb;padding:24px;border-radius:10px}
  .contact-form button{border:0;cursor:pointer;justify-self:start}
  /* Off-screen rather than display:none — a bot that skips hidden inputs is
     exactly the bot this is for. */
  .hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
</style>
