{# Component: video — an embed, a self-hosted loop, or both. #}
<section class="video-block">
  <div class="wrap">
    {% if fields.heading %}<h2>{{ fields.heading }}</h2>{% endif %}

    {% if fields.loop.src|default('') %}
      {# muted + playsinline are not optional: without either, no browser will
         autoplay it, and the visitor is shown a frozen first frame. The poster
         is what someone with reduced-motion or a failed load actually sees. #}
      <video class="loop" autoplay loop muted playsinline preload="metadata"
             {% if fields.loop.poster.src|default('') %}poster="{{ fields.loop.poster.src }}"{% endif %}
             {% if fields.loop.poster.width|default(0) > 0 %}
             width="{{ fields.loop.poster.width }}" height="{{ fields.loop.poster.height }}"
             {% endif %}>
        <source src="{{ fields.loop.src }}" type="video/mp4">
      </video>
    {% endif %}

    {% include 'video_facade.twig' with {
         video: fields.embed,
         poster: fields.poster,
         title: fields.heading
       } only %}
  </div>
</section>

<style>
  .video-block{padding:72px 0}
  .video-block .loop{width:100%;height:auto;border-radius:10px;display:block;margin-bottom:24px}
  /* A background loop is decoration; someone who asked the OS for less motion
     asked for this too. The poster stays, so the section is not empty. */
  @media (prefers-reduced-motion: reduce){
    .video-block .loop{display:none}
  }
</style>
