{# Component: gallery — a grid of photos, every one through picture.twig. #}
<section class="gallery-block">
  <div class="wrap">
    {% if fields.heading %}<h2>{{ fields.heading }}</h2>{% endif %}

    {% if fields.photos %}
      <div class="grid">
        {% for photo in fields.photos %}
          {# Never lazy: false here. A gallery is below the fold by
             construction, and thirty eager images is the LCP mistake at scale. #}
          {% include 'picture.twig' with {
               image: photo,
               widths: [320, 640, 960],
               sizes: '(min-width: 900px) 300px, 45vw'
             } only %}
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .gallery-block{padding:72px 0}
  .gallery-block .grid{display:grid;gap:12px;grid-template-columns:repeat(2,1fr)}
  .gallery-block .grid picture{display:block}
  .gallery-block .grid img{aspect-ratio:4/3;object-fit:cover;border-radius:8px}
  @media (min-width:900px){.gallery-block .grid{grid-template-columns:repeat(3,1fr)}}
</style>
