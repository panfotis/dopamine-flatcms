{# Component: text_image #}
<section class="text-image">
  <div class="wrap grid" style="--side:{{ fields.media_side|default('end') }}">
    <div class="copy">
      {% if fields.heading %}<h2>{{ fields.heading }}</h2>{% endif %}
      {{ fields.body|raw }}
    </div>

    {% if fields.image %}
      <figure class="media">
        <img src="{{ img(fields.image, 900) }}" alt="{{ fields.image_alt }}" loading="lazy"
             srcset="{{ img(fields.image, 600) }} 600w, {{ img(fields.image, 1200) }} 1200w"
             sizes="(min-width:820px) 46vw, 100vw">
      </figure>
    {% endif %}
  </div>
</section>

<style>
  .text-image{padding:72px 0}
  .text-image .grid{display:grid;gap:44px;align-items:center}
  .text-image .media{margin:0}
  .text-image .media img{border-radius:12px}
  @media (min-width:820px){
    .text-image .grid{grid-template-columns:1fr 1fr}
    .text-image .media{order:var(--order,2)}
    .text-image .grid[style*="--side:start"] .media{order:0}
  }
</style>
