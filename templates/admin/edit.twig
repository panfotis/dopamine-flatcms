{% extends 'admin/_layout.twig' %}
{% block title %}{{ page.title }}{% endblock %}

{% block content %}
  <h1>{{ page.title }}</h1>
  <p class="sub">
    <a href="?">← Όλες οι σελίδες</a> ·
    <code>{{ page.slug }}</code>
  </p>

  {% if notice %}<div class="flash ok">{{ notice }}</div>{% endif %}
  {% if warn %}<div class="flash warn">{{ warn }}</div>{% endif %}

  {% if conflict %}
    <div class="flash err">
      <strong>{{ conflict }}</strong>
      <p style="margin:.6em 0 0">
        Δεν αποθηκεύτηκε τίποτα. <strong>Τα κείμενα που γράψατε είναι ακόμα στη
        φόρμα παρακάτω</strong> — ελέγξτε τα και πατήστε ξανά Αποθήκευση για να
        αντικαταστήσετε την άλλη έκδοση, ή ανανεώστε τη σελίδα για να τα
        απορρίψετε.
      </p>
    </div>
  {% endif %}

  {% if held_by %}
    <div class="flash warn">
      Ο/Η <strong>{{ held_by.user }}</strong> άνοιξε αυτή τη σελίδα
      {% if held_by.minutes < 1 %}μόλις τώρα{% else %}πριν {{ held_by.minutes }} λεπτά{% endif %}.
      Συνεννοηθείτε πριν αποθηκεύσετε.
    </div>
  {% endif %}

  <form method="post" id="editor" enctype="multipart/form-data">
    <input type="hidden" name="action" value="save">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="page" value="{{ page.id }}">
    {# Fingerprint of the file as it was when this form was rendered. The save
       is refused if it no longer matches, so a second tab cannot silently
       overwrite what the first one saved. #}
    <input type="hidden" name="baseline" value="{{ baseline }}">

    <div class="card">
      <header><h2>Σελίδα</h2></header>
      <div class="body">
        <div class="field">
          <label for="page-title">Τίτλος σελίδας</label>
          <input type="text" id="page-title" name="title" value="{{ page.title }}" maxlength="120">
          <p class="hint">Εμφανίζεται στην καρτέλα του browser και στα αποτελέσματα αναζήτησης.</p>
        </div>
      </div>
    </div>

    {% for block in blocks %}
      <div class="card">
        <header>
          <h2>{{ block.label }}</h2>
          <span class="pill">{{ block.type }}</span>
        </header>
        <div class="body">
          {% if block.missing %}
            <div class="flash err">Το component «{{ block.type }}» δεν βρέθηκε στον φάκελο components/.</div>
          {% elseif block.fields is empty %}
            <p class="hint">Αυτή η ενότητα δεν έχει πεδία προς επεξεργασία.</p>
          {% else %}
            {% if block.hint %}<p class="hint" style="margin-bottom:16px">{{ block.hint }}</p>{% endif %}

            {% for name, def in block.fields %}
              {% set value = block.values[name]|default('') %}
              {% set id = block.id ~ '-' ~ name %}
              {% set fname = 'blocks[' ~ block.id ~ '][' ~ name ~ ']' %}
              {# The same function the save path calls. Locking here is a
                 courtesy to the editor; cleanValues() is what enforces it. #}
              {% set locked = not may_edit(def.editable, user.role) %}

              {% if def.type == 'list' %}
                {{ _self.repeater(def, id, fname, value, locked, pages, page_ids, user.role) }}
              {% else %}
                {{ _self.field(def, id, fname, value, locked, pages, page_ids) }}
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>
    {% endfor %}

    <div class="savebar"><div class="inner">
      <button class="btn" type="submit">Αποθήκευση</button>
      <a class="btn ghost" href="{{ page.slug }}" target="_blank" rel="noopener">Προβολή σελίδας</a>
      {% if user.role == 'admin' %}
        <a class="btn ghost" href="?action=revisions&amp;page={{ page.id }}">Προηγούμενες εκδόσεις</a>
      {% endif %}
      <span class="status" id="status">Οι αλλαγές δημοσιεύονται αμέσως μετά την αποθήκευση.</span>
    </div></div>
  </form>
{% endblock %}

{#
  One input renderer, called at the top level and once per row of a list. Two
  copies of this chain would drift, and the copy inside the repeater is exactly
  where a locked field or a missing alt would stop being enforced in the UI.
#}
{% macro field(def, id, fname, value, locked, pages, page_ids) %}
              <div class="field">
                <label for="{{ id }}">
                  {{ def.label }}
                  {% if locked %}<span class="pill" style="margin-inline-start:6px">κλειδωμένο</span>{% endif %}
                  {% if def.editable is same as('admin') %}<span class="pill" style="margin-inline-start:6px">μόνο διαχειριστής</span>{% endif %}
                  {% if def.max is defined and not locked %}
                    <span class="counter" data-for="{{ id }}" data-max="{{ def.max }}"></span>
                  {% endif %}
                </label>

                {% if def.type == 'textarea' %}
                  <textarea id="{{ id }}" name="{{ fname }}" {{ locked ? 'readonly' : '' }}
                            {% if def.max is defined %}data-max="{{ def.max }}"{% endif %}>{{ value }}</textarea>

                {% elseif def.type == 'richtext' %}
                  {% if not locked %}
                    <div class="rt-toolbar" data-rt-toolbar="{{ id }}">
                      <button type="button" data-cmd="bold" title="Έντονα"><b>B</b></button>
                      <button type="button" data-cmd="italic" title="Πλάγια"><i>I</i></button>
                      <button type="button" data-cmd="insertUnorderedList" title="Λίστα">•</button>
                      <button type="button" data-cmd="createLink" title="Σύνδεσμος">🔗</button>
                      <button type="button" data-cmd="removeFormat" title="Καθαρισμός">✕</button>
                    </div>
                  {% endif %}
                  <div class="rt" id="{{ id }}-rt" {{ locked ? '' : 'contenteditable="true"' }}
                       data-target="{{ id }}">{{ value|raw }}</div>
                  <textarea id="{{ id }}" name="{{ fname }}" hidden>{{ value }}</textarea>

                {% elseif def.type == 'image' %}
                  {% set src = value.src|default('') %}
                  <div class="media">
                    <div class="thumb" id="{{ id }}-thumb"
                         style="{% if src %}background-image:url('{{ src }}'){% endif %}"></div>
                    <div class="controls">
                      {% if not locked %}
                        <input type="file" id="{{ id }}-file" accept="image/jpeg,image/png,image/webp" hidden>
                        <button type="button" class="btn ghost" data-upload="{{ id }}">Αλλαγή εικόνας</button>
                        <button type="button" class="btn ghost" data-clear="{{ id }}">Αφαίρεση</button>
                      {% endif %}
                      <input type="hidden" id="{{ id }}" name="{{ fname }}[src]" value="{{ src }}">
                      <p class="path" id="{{ id }}-path">{{ src ?: 'Καμία εικόνα' }}</p>
                    </div>
                  </div>
                  {# alt comes with the image field rather than beside it, so a
                     new component cannot ship without one. A decorative image
                     is declared as such in schema.yml and shows no input at
                     all — an empty alt is the right markup for it, and asking
                     for one produces "photo" and "logo123.jpg". #}
                  {% if not def.decorative %}
                    <div class="field" style="margin-top:12px">
                      <label for="{{ id }}-alt">{{ def.fields.alt.label }}</label>
                      <input type="text" id="{{ id }}-alt" name="{{ fname }}[alt]"
                             value="{{ value.alt|default('') }}"
                             {{ locked ? 'readonly' : '' }}
                             maxlength="{{ def.fields.alt.max }}" data-max="{{ def.fields.alt.max }}">
                      <p class="hint">{{ def.fields.alt.hint }}</p>
                    </div>
                  {% endif %}

                {% elseif def.type == 'select' %}
                  <select id="{{ id }}" name="{{ fname }}" {{ locked ? 'disabled' : '' }}>
                    {% for optValue, optLabel in def.options|default({}) %}
                      <option value="{{ optValue }}" {{ value == optValue ? 'selected' : '' }}>{{ optLabel }}</option>
                    {% endfor %}
                  </select>
                  {% if locked %}<input type="hidden" name="{{ fname }}" value="{{ value }}">{% endif %}

                {% elseif def.type == 'boolean' %}
                  {# The hidden field first, so an unchecked box still posts —
                     otherwise "off" is indistinguishable from "not sent", and
                     the save path would keep the stored value forever. #}
                  <input type="hidden" name="{{ fname }}" value="0">
                  <input type="checkbox" id="{{ id }}" name="{{ fname }}" value="1"
                         {{ value ? 'checked' : '' }} {{ locked ? 'disabled' : '' }}>

                {% elseif def.type == 'link' %}
                  {# A page picker, not a URL box: it stores the page id, and
                     the slug is resolved at render time — so renaming a slug
                     cannot leave a dead href behind. #}
                  <select id="{{ id }}" name="{{ fname }}" {{ locked ? 'disabled' : '' }}>
                    <option value="">— Καμία σελίδα —</option>
                    {% for p in pages|default([]) %}
                      <option value="{{ p.id }}" {{ value == p.id ? 'selected' : '' }}>{{ p.title }} ({{ p.slug }})</option>
                    {% endfor %}
                  </select>
                  {% if locked %}<input type="hidden" name="{{ fname }}" value="{{ value }}">{% endif %}
                  {% if value and value not in page_ids|default([]) %}
                    <p class="hint" style="color:#b4232a">
                      Η σελίδα «{{ value }}» δεν υπάρχει πια. Ο σύνδεσμος εμφανίζεται ως απλό κείμενο.
                    </p>
                  {% endif %}

                {% else %}
                  <input type="text" id="{{ id }}" name="{{ fname }}" value="{{ value }}"
                         {{ locked ? 'readonly' : '' }}
                         {% if def.max is defined %}maxlength="{{ def.max }}" data-max="{{ def.max }}"{% endif %}
                         {% if def.placeholder is defined %}placeholder="{{ def.placeholder }}"{% endif %}>
                {% endif %}

                {% if def.hint is defined %}<p class="hint">{{ def.hint }}</p>{% endif %}
              </div>
{% endmacro %}

{#
  A repeater over a fixed sub-schema. The client adds and removes *rows*, which
  is content; the fields inside a row are the developer's, which is structure.
  Rows carry no id — the save path re-indexes with array_values() and cuts to
  `max` before it sanitises anything, so a reordered or renumbered form is not
  something this has to keep straight.
#}
{% macro repeater(def, id, fname, rows, locked, pages, page_ids, role) %}
  <div class="field">
    <label>
      {{ def.label }}
      {% if locked %}<span class="pill" style="margin-inline-start:6px">κλειδωμένο</span>{% endif %}
      <span class="pill" style="margin-inline-start:6px">έως {{ def.max }}</span>
    </label>
    {% if def.hint is defined %}<p class="hint">{{ def.hint }}</p>{% endif %}

    <div class="repeater" id="{{ id }}-rows" data-repeater="{{ id }}" data-max="{{ def.max }}">
      {% for i, row in (rows is iterable ? rows : []) %}
        <div class="repeater-row" data-row>
          <header>
            <strong>{{ row[def.item_label]|default('')|striptags|slice(0, 60) ?: def.label }}</strong>
            {% if not locked %}<button type="button" class="btn ghost" data-row-remove>Αφαίρεση</button>{% endif %}
          </header>
          {% for subName, subDef in def.fields %}
            {{ _self.field(
                 subDef,
                 id ~ '-' ~ i ~ '-' ~ subName,
                 fname ~ '[' ~ i ~ '][' ~ subName ~ ']',
                 row[subName]|default(''),
                 locked or not may_edit(subDef.editable, role),
                 pages,
                 page_ids
               ) }}
          {% endfor %}
        </div>
      {% endfor %}
    </div>

    {% if not locked %}
      <button type="button" class="btn ghost" data-row-add="{{ id }}">Προσθήκη</button>
      {# __INDEX__ is replaced on insert. A <template> keeps the blank row out
         of the form until it is wanted — an empty row that posts is an empty
         row the save path has to refuse. #}
      <template id="{{ id }}-template">
        <div class="repeater-row" data-row>
          <header>
            <strong>{{ def.label }}</strong>
            <button type="button" class="btn ghost" data-row-remove>Αφαίρεση</button>
          </header>
          {% for subName, subDef in def.fields %}
            {{ _self.field(
                 subDef,
                 id ~ '-__INDEX__-' ~ subName,
                 fname ~ '[__INDEX__][' ~ subName ~ ']',
                 '',
                 not may_edit(subDef.editable, role),
                 pages,
                 page_ids
               ) }}
          {% endfor %}
        </div>
      </template>
    {% endif %}
  </div>
{% endmacro %}

{% block foot %}
<script>
(function () {
  const form = document.getElementById('editor');
  const status = document.getElementById('status');
  const csrf = form.querySelector('[name=csrf]').value;
  let dirty = false;
  const touch = () => { dirty = true; };

  /* ---- character counters ------------------------------------------- */
  document.querySelectorAll('.counter[data-for]').forEach(el => {
    const input = document.getElementById(el.dataset.for);
    if (!input) return;
    const max = parseInt(el.dataset.max, 10);
    const paint = () => {
      const n = (input.value || '').length;
      el.textContent = n + '/' + max;
      el.classList.toggle('over', n > max);
    };
    input.addEventListener('input', paint);
    paint();
  });

  /* ---- minimal rich text --------------------------------------------
     A contenteditable with four buttons. Deliberately tiny: the server
     strips everything except p/br/strong/em/u/a/ul/ol/li anyway, so there
     is no point offering the client formatting that will be thrown away. */
  document.querySelectorAll('.rt[contenteditable]').forEach(rt => {
    const target = document.getElementById(rt.dataset.target);
    const sync = () => { target.value = rt.innerHTML; touch(); };
    rt.addEventListener('input', sync);

    rt.addEventListener('paste', e => {
      e.preventDefault();
      const text = (e.clipboardData || window.clipboardData).getData('text/plain');
      document.execCommand('insertText', false, text);
    });

    const bar = document.querySelector('[data-rt-toolbar="' + rt.dataset.target + '"]');
    if (!bar) return;
    bar.addEventListener('click', e => {
      const btn = e.target.closest('button');
      if (!btn) return;
      rt.focus();
      if (btn.dataset.cmd === 'createLink') {
        const url = prompt('Διεύθυνση συνδέσμου:', 'https://');
        if (url) document.execCommand('createLink', false, url);
      } else {
        document.execCommand(btn.dataset.cmd, false, null);
      }
      sync();
    });
  });

  /* ---- image upload --------------------------------------------------- */
  document.querySelectorAll('[data-upload]').forEach(btn => {
    const id = btn.dataset.upload;
    const file = document.getElementById(id + '-file');
    const hidden = document.getElementById(id);
    const thumb = document.getElementById(id + '-thumb');
    const path = document.getElementById(id + '-path');

    btn.addEventListener('click', () => file.click());

    file.addEventListener('change', async () => {
      if (!file.files.length) return;
      const body = new FormData();
      body.append('action', 'upload');
      body.append('csrf', csrf);
      body.append('file', file.files[0]);

      btn.disabled = true;
      status.textContent = 'Μεταφόρτωση…';
      try {
        const res = await fetch('?action=upload', { method: 'POST', body });
        const data = await res.json();
        if (!data.ok) throw new Error(data.message || 'Η μεταφόρτωση απέτυχε.');
        hidden.value = data.url;
        thumb.style.backgroundImage = "url('" + (data.preview || data.url) + "')";
        path.textContent = data.url;
        status.textContent = 'Η εικόνα ανέβηκε. Πατήστε Αποθήκευση.';
        touch();
      } catch (err) {
        status.textContent = err.message;
      } finally {
        btn.disabled = false;
        file.value = '';
      }
    });
  });

  document.querySelectorAll('[data-clear]').forEach(btn => {
    const id = btn.dataset.clear;
    btn.addEventListener('click', () => {
      document.getElementById(id).value = '';
      document.getElementById(id + '-thumb').style.backgroundImage = '';
      document.getElementById(id + '-path').textContent = 'Καμία εικόνα';
      touch();
    });
  });

  /* ---- list repeaters -------------------------------------------------
     Rows are content, so the client adds and removes them. The fields inside
     a row are not, so they come from the template and nothing here invents
     one. Indices need no tidying on remove: the server re-keys with
     array_values() and cuts to `max` before it sanitises anything. */
  document.querySelectorAll('[data-row-add]').forEach(btn => {
    const id = btn.dataset.rowAdd;
    const rows = document.getElementById(id + '-rows');
    const tpl = document.getElementById(id + '-template');
    const max = parseInt(rows.dataset.max, 10);
    let next = rows.querySelectorAll('[data-row]').length;

    const paint = () => { btn.disabled = rows.querySelectorAll('[data-row]').length >= max; };

    btn.addEventListener('click', () => {
      if (rows.querySelectorAll('[data-row]').length >= max) return;
      const html = tpl.innerHTML.replaceAll('__INDEX__', String(next++));
      rows.insertAdjacentHTML('beforeend', html);
      paint();
      touch();
    });

    rows.addEventListener('click', e => {
      if (!e.target.closest('[data-row-remove]')) return;
      e.target.closest('[data-row]').remove();
      paint();
      touch();
    });

    paint();
  });

  /* ---- don't lose work ------------------------------------------------ */
  form.addEventListener('input', touch);
  form.addEventListener('submit', () => { dirty = false; });
  window.addEventListener('beforeunload', e => {
    if (dirty) { e.preventDefault(); e.returnValue = ''; }
  });
})();
</script>
{% endblock %}
