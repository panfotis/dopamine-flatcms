{% extends 'admin/_layout.twig' %}
{% block title %}{{ page.title }}{% endblock %}

{% block content %}
  <h1>{{ page.title }}</h1>
  <p class="sub">
    <a href="?locale={{ locale }}">{{ t('nav.back') }}</a> ·
    {% if locales|length > 1 %}{{ locales[locale].label }} · {% endif %}
    {% if global %}
      {{ t('edit.everywhere') }}
    {% else %}
      <code>{{ page.slug }}</code>
    {% endif %}
  </p>

  {% if notice %}<div class="flash ok">{{ notice }}</div>{% endif %}
  {% if warn %}<div class="flash warn">{{ warn }}</div>{% endif %}

  {% if errors|default({})|length %}
    <div class="flash err">
      <strong>{{ t('flash.nothing_saved') }}</strong>
      <p style="margin:.6em 0 0">
        {{ errors|length == 1
             ? t('flash.fields_need_filling', errors|length)
             : t('flash.fields_need_filling_plural', errors|length) }}
        {{ t('flash.text_kept') }}
      </p>
    </div>
  {% endif %}

  {% if conflict %}
    <div class="flash err">
      <strong>{{ conflict }}</strong>
      <p style="margin:.6em 0 0">
        {{ t('flash.conflict_help') }}
      </p>
    </div>
  {% endif %}

  {% if held_by %}
    <div class="flash warn">
      {{ t('flash.held_by', held_by.user, held_by.minutes < 1
           ? t('flash.held_just_now')
           : t('flash.held_minutes', held_by.minutes)) }}
    </div>
  {% endif %}

  <form method="post" id="editor" enctype="multipart/form-data">
    <input type="hidden" name="action" value="save">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    <input type="hidden" name="page" value="{{ page.id }}">
    {# Which language this form is editing. Without it a save from the English
       screen would land in the Greek file, which is the kind of mistake nobody
       notices until the wrong copy is live. #}
    <input type="hidden" name="locale" value="{{ locale }}">
    {# Fingerprint of the file as it was when this form was rendered. The save
       is refused if it no longer matches, so a second tab cannot silently
       overwrite what the first one saved. #}
    <input type="hidden" name="baseline" value="{{ baseline }}">

    {# Collapsed, and <details> rather than a script: SEO is the one part of
       this form an editor is entitled to ignore completely. Every field in it
       is optional, the inputs post whether or not the card was ever opened,
       and the save path writes the stored values straight back — so "never
       touched it" and "cannot save" must not be the same thing. #}
    {# A global renders inside every page and has no head of its own, so there
       is nothing for these five fields to reach. Admin::save() skips the same
       walk — the card is not merely hidden. #}
    {% if not global %}
      <details class="card">
        <summary>
          <h2>{{ t('edit.seo') }}</h2>
          <span class="pill">{{ t('edit.optional') }}</span>
        </summary>
        <div class="body">
          {# The same renderer as every other field, so a locked one is locked
             here too and the alt input appears exactly where the save path
             demands one. #}
          {% for name, def in seo_fields %}
            {{ _self.field(def, 'seo-' ~ name, 'seo[' ~ name ~ ']', seo[name]|default(''),
                           not may_edit(def.editable, user.role), pages, page_ids, errors|default({})) }}
          {% endfor %}
        </div>
      </details>

      <div class="card">
        <header><h2>{{ t('edit.page') }}</h2></header>
        <div class="body">
          <div class="field">
            <label for="page-title">{{ t('edit.page_title') }}</label>
            <input type="text" id="page-title" name="title" value="{{ page.title }}" maxlength="120">
            <p class="hint">{{ t('edit.page_title_hint') }}</p>
          </div>
        </div>
      </div>
    {% endif %}

    {% for block in blocks %}
      <div class="card">
        <header>
          <h2>{{ block.label }}</h2>
          <span class="pill">{{ block.type }}</span>
        </header>
        <div class="body">
          {% if block.missing %}
            <div class="flash err">{{ t('edit.missing_component', block.type) }}</div>
          {% elseif block.fields is empty %}
            <p class="hint">{{ t('edit.no_fields') }}</p>
          {% else %}
            {% if block.hint %}<p class="hint" style="margin-bottom:16px">{{ block.hint }}</p>{% endif %}

            {% for name, def in block.fields %}
              {% set value = block.values[name]|default('') %}
              {% set id = block.id ~ '-' ~ name %}
              {% set fname = 'blocks[' ~ block.id ~ '][' ~ name ~ ']' %}
              {# The same function the save path calls. Locking here is a
                 courtesy to the editor; cleanValues() is what enforces it. #}
              {% set locked = not may_edit(def.editable, user.role) %}

              {% if def.type == 'list' %}
                {{ _self.repeater(def, id, fname, value, locked, pages, page_ids, user.role, errors|default({})) }}
              {% else %}
                {{ _self.field(def, id, fname, value, locked, pages, page_ids, errors|default({})) }}
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>
      </div>
    {% endfor %}

    <div class="savebar"><div class="inner">
      <button class="btn" type="submit">{{ t('edit.save') }}</button>
      {# A global has no address to open — it is already on every page. #}
      {% if not global %}
        <a class="btn ghost" href="{{ locales[locale].prefix }}{{ page.slug }}" target="_blank" rel="noopener">{{ t('edit.view_page') }}</a>
      {% endif %}
      {% if user.role == 'admin' %}
        <a class="btn ghost" href="?action=revisions&amp;page={{ page.id }}&amp;locale={{ locale }}">{{ t('edit.revisions') }}</a>
      {% endif %}
      <span class="status" id="status">{{ t('edit.published') }}</span>
    </div></div>
  </form>
{% endblock %}

{#
  One input renderer, called at the top level and once per row of a list. Two
  copies of this chain would drift, and the copy inside the repeater is exactly
  where a locked field or a missing alt would stop being enforced in the UI.
#}
{% macro field(def, id, fname, value, locked, pages, page_ids, errors) %}
              {# Keyed by the input's own name attribute, which is the string
                 the save path reports a refusal against — so the message lands
                 on the box that caused it, at any nesting depth. #}
              {% set errors = errors|default({}) %}
              {% set error = errors[fname]|default(null) %}
              {# The schema's own `required`, handed to the browser. Only on
                 inputs the client can see and focus: a required control that
                 is hidden (richtext's mirror textarea) blocks the submit with
                 a bubble nobody can read. Those are refused server-side and
                 come back as an inline message like everything else. #}
              {% set demand = def.required|default(false) and not locked %}
              <div class="field{{ error ? ' has-error' : '' }}">
                <label for="{{ id }}">
                  {{ t(def.label) }}
                  {% if locked %}<span class="pill" style="margin-inline-start:6px">{{ t('edit.locked') }}</span>{% endif %}
                  {% if def.editable is same as('admin') %}<span class="pill" style="margin-inline-start:6px">{{ t('edit.admin_only') }}</span>{% endif %}
                  {% if def.max is defined and not locked %}
                    <span class="counter" data-for="{{ id }}" data-max="{{ def.max }}"></span>
                  {% endif %}
                </label>

                {% if def.type == 'textarea' %}
                  {# A placeholder here is not decoration: seo.description
                     carries the line the head will publish if this is left
                     empty, so the client can read it and decide whether they
                     can do better. #}
                  <textarea id="{{ id }}" name="{{ fname }}" {{ locked ? 'readonly' : '' }}
                            {{ demand ? 'required' : '' }} {{ error ? 'aria-invalid="true"' : '' }}
                            {% if def.placeholder is defined and def.placeholder %}placeholder="{{ def.placeholder }}"{% endif %}
                            {% if def.max is defined %}data-max="{{ def.max }}"{% endif %}>{{ value }}</textarea>

                {% elseif def.type == 'richtext' %}
                  {% if not locked %}
                    <div class="rt-toolbar" data-rt-toolbar="{{ id }}">
                      <button type="button" data-cmd="bold" title="{{ t('rt.bold') }}"><b>B</b></button>
                      <button type="button" data-cmd="italic" title="{{ t('rt.italic') }}"><i>I</i></button>
                      <button type="button" data-cmd="insertUnorderedList" title="{{ t('rt.list') }}">•</button>
                      <button type="button" data-cmd="createLink" title="{{ t('rt.link') }}">🔗</button>
                      <button type="button" data-cmd="removeFormat" title="{{ t('rt.clear') }}">✕</button>
                    </div>
                  {% endif %}
                  <div class="rt" id="{{ id }}-rt" {{ locked ? '' : 'contenteditable="true"' }}
                       data-target="{{ id }}">{{ value|raw }}</div>
                  <textarea id="{{ id }}" name="{{ fname }}" hidden>{{ value }}</textarea>

                {% elseif def.type == 'image' %}
                  {% set src = value.src|default('') %}
                  <div class="media">
                    <div class="thumb" id="{{ id }}-thumb"
                         style="{% if src %}background-image:url('{{ src }}'){% endif %}"></div>
                    <div class="controls">
                      {% if not locked %}
                        <input type="file" id="{{ id }}-file" accept="image/jpeg,image/png,image/webp" hidden>
                        <button type="button" class="btn ghost" data-upload="{{ id }}">{{ t('edit.change_image') }}</button>
                        <button type="button" class="btn ghost" data-clear="{{ id }}">{{ t('edit.remove') }}</button>
                      {% endif %}
                      <input type="hidden" id="{{ id }}" name="{{ fname }}[src]" value="{{ src }}">
                      <p class="path" id="{{ id }}-path">{{ src ?: t('edit.no_image') }}</p>
                    </div>
                  </div>
                  {# alt comes with the image field rather than beside it, so a
                     new component cannot ship without one. A decorative image
                     is declared as such in schema.yml and shows no input at
                     all — an empty alt is the right markup for it, and asking
                     for one produces "photo" and "logo123.jpg". #}
                  {% if not def.decorative %}
                    {% set altError = errors[fname ~ '[alt]']|default(null) %}
                    <div class="field{{ altError ? ' has-error' : '' }}" style="margin-top:12px">
                      <label for="{{ id }}-alt">{{ t(def.fields.alt.label) }}</label>
                      {# The same rule the save path applies, stated to the
                         browser: required exactly when there is an image. No
                         validation library — the round trip is the fallback,
                         not the mechanism. #}
                      <input type="text" id="{{ id }}-alt" name="{{ fname }}[alt]"
                             value="{{ value.alt|default('') }}"
                             {{ locked ? 'readonly' : '' }}
                             {{ src and not locked ? 'required' : '' }}
                             {{ altError ? 'aria-invalid="true"' : '' }}
                             maxlength="{{ def.fields.alt.max }}" data-max="{{ def.fields.alt.max }}">
                      {% if altError %}<p class="err">{{ altError }}</p>{% endif %}
                      <p class="hint">{{ t(def.fields.alt.hint) }}</p>
                    </div>
                  {% endif %}

                {% elseif def.type == 'image_list' %}
                  {# A grid, not thirty stacked cards. Reorder is up/down
                     buttons rather than drag: ten lines, keyboard-accessible
                     for free, and no library in a project with no front-end
                     build. Add dragging if someone actually complains. #}
                  <div class="gallery" id="{{ id }}-grid" data-gallery="{{ id }}"
                       data-name="{{ fname }}" data-max="{{ def.max|default(60) }}"
                       data-decorative="{{ def.decorative|default(false) ? '1' : '' }}"
                       data-alt-label="{{ t(def.fields.alt.label) }}">
                    {% for i, photo in value|default([]) %}
                      <figure class="tile" data-tile>
                        <div class="thumb" style="background-image:url('{{ photo.src }}')"></div>
                        <input type="hidden" name="{{ fname }}[{{ i }}][src]" value="{{ photo.src }}">
                        {% if not def.decorative %}
                          {# Optional here and required on a standalone image:
                             thirty forced descriptions produce thirty junk
                             strings, which a screen reader reads out instead
                             of skipping. #}
                          <input type="text" class="alt" name="{{ fname }}[{{ i }}][alt]"
                                 value="{{ photo.alt|default('') }}" maxlength="120"
                                 placeholder="{{ t(def.fields.alt.label) }}" {{ locked ? 'readonly' : '' }}>
                        {% endif %}
                        {% if not locked %}
                          <div class="tools">
                            <button type="button" data-move="-1" title="{{ t('edit.move_earlier') }}">↑</button>
                            <button type="button" data-move="1" title="{{ t('edit.move_later') }}">↓</button>
                            <button type="button" data-drop title="{{ t('edit.remove') }}">✕</button>
                          </div>
                        {% endif %}
                      </figure>
                    {% endfor %}
                  </div>
                  {% if not locked %}
                    <input type="file" id="{{ id }}-files" accept="image/jpeg,image/png,image/webp" multiple hidden>
                    <button type="button" class="btn ghost" data-gallery-add="{{ id }}">{{ t('edit.add_photos') }}</button>
                    <span class="hint" data-gallery-status="{{ id }}"></span>
                  {% endif %}

                {% elseif def.type == 'video_embed' %}
                  {# The client pastes what is in their address bar. What is
                     stored is a provider and an id, and the template builds the
                     iframe — pasted HTML is never stored, so it can never be
                     rendered. #}
                  <input type="url" id="{{ id }}" name="{{ fname }}"
                         value="{{ value.provider|default('') == 'youtube' ? 'https://www.youtube.com/watch?v=' ~ value.id
                                 : (value.provider|default('') == 'vimeo' ? 'https://vimeo.com/' ~ value.id : '') }}"
                         {{ locked ? 'readonly' : '' }} placeholder="https://www.youtube.com/watch?v=…">
                  {% if value.provider|default('') %}
                    <p class="hint">{{ t('edit.stored_as', value.provider, value.id) }}</p>
                  {% endif %}

                {% elseif def.type == 'video_loop' %}
                  <div class="media">
                    <div class="thumb" id="{{ id }}-thumb"
                         style="{% if value.poster.src|default('') %}background-image:url('{{ value.poster.src }}'){% endif %}"></div>
                    <div class="controls">
                      {% if not locked %}
                        <input type="file" id="{{ id }}-file" accept="video/mp4" hidden>
                        <button type="button" class="btn ghost" data-upload="{{ id }}">{{ t('edit.change_video') }}</button>
                        <button type="button" class="btn ghost" data-clear="{{ id }}">{{ t('edit.remove') }}</button>
                      {% endif %}
                      <input type="hidden" id="{{ id }}" name="{{ fname }}[src]" value="{{ value.src|default('') }}">
                      <p class="path" id="{{ id }}-path">{{ value.src|default('') ?: t('edit.no_video') }}</p>
                    </div>
                  </div>
                  {# The poster is what a visitor with autoplay off actually
                     sees, so it is an ordinary image field with everything that
                     comes with one — including a required description. #}
                  {{ _self.field(
                       {'type': 'image', 'label': t('edit.poster'), 'decorative': def.decorative|default(false),
                        'fields': def.fields.poster.fields, 'hint': t('edit.poster_hint')},
                       id ~ '-poster', fname ~ '[poster]', value.poster|default({}), locked, pages, page_ids, errors
                     ) }}

                {% elseif def.type == 'select' %}
                  <select id="{{ id }}" name="{{ fname }}" {{ locked ? 'disabled' : '' }}>
                    {% for optValue, optLabel in def.options|default({}) %}
                      <option value="{{ optValue }}" {{ value == optValue ? 'selected' : '' }}>{{ optLabel }}</option>
                    {% endfor %}
                  </select>
                  {% if locked %}<input type="hidden" name="{{ fname }}" value="{{ value }}">{% endif %}

                {% elseif def.type == 'boolean' %}
                  {# The hidden field first, so an unchecked box still posts —
                     otherwise "off" is indistinguishable from "not sent", and
                     the save path would keep the stored value forever. #}
                  <input type="hidden" name="{{ fname }}" value="0">
                  <input type="checkbox" id="{{ id }}" name="{{ fname }}" value="1"
                         {{ value ? 'checked' : '' }} {{ locked ? 'disabled' : '' }}>

                {% elseif def.type == 'link' %}
                  {# A page picker, not a URL box: it stores the page id, and
                     the slug is resolved at render time — so renaming a slug
                     cannot leave a dead href behind. #}
                  <select id="{{ id }}" name="{{ fname }}" {{ locked ? 'disabled' : '' }}>
                    <option value="">{{ t('edit.no_page') }}</option>
                    {% for p in pages|default([]) %}
                      <option value="{{ p.id }}" {{ value == p.id ? 'selected' : '' }}>{{ p.title }} ({{ p.slug }})</option>
                    {% endfor %}
                  </select>
                  {% if locked %}<input type="hidden" name="{{ fname }}" value="{{ value }}">{% endif %}
                  {% if value and value not in page_ids|default([]) %}
                    <p class="hint" style="color:#b4232a">
                      {{ t('edit.dead_link', value) }}
                    </p>
                  {% endif %}

                {% else %}
                  <input type="text" id="{{ id }}" name="{{ fname }}" value="{{ value }}"
                         {{ locked ? 'readonly' : '' }}
                         {{ demand ? 'required' : '' }} {{ error ? 'aria-invalid="true"' : '' }}
                         {% if def.max is defined %}maxlength="{{ def.max }}" data-max="{{ def.max }}"{% endif %}
                         {% if def.placeholder is defined %}placeholder="{{ def.placeholder }}"{% endif %}>
                {% endif %}

                {% if error %}<p class="err">{{ error }}</p>{% endif %}
                {% if def.hint is defined %}<p class="hint">{{ t(def.hint) }}</p>{% endif %}
              </div>
{% endmacro %}

{#
  A repeater over a fixed sub-schema. The client adds and removes *rows*, which
  is content; the fields inside a row are the developer's, which is structure.
  Rows carry no id — the save path re-indexes with array_values() and cuts to
  `max` before it sanitises anything, so a reordered or renumbered form is not
  something this has to keep straight.
#}
{% macro repeater(def, id, fname, rows, locked, pages, page_ids, role, errors) %}
  <div class="field">
    <label>
      {{ t(def.label) }}
      {% if locked %}<span class="pill" style="margin-inline-start:6px">{{ t('edit.locked') }}</span>{% endif %}
      <span class="pill" style="margin-inline-start:6px">{{ t('edit.up_to', def.max) }}</span>
    </label>
    {% if def.hint is defined %}<p class="hint">{{ t(def.hint) }}</p>{% endif %}

    <div class="repeater" id="{{ id }}-rows" data-repeater="{{ id }}" data-max="{{ def.max }}">
      {% for i, row in (rows is iterable ? rows : []) %}
        <div class="repeater-row" data-row>
          <header>
            <strong>{{ row[def.item_label]|default('')|striptags|slice(0, 60) ?: t(def.label) }}</strong>
            {% if not locked %}<button type="button" class="btn ghost" data-row-remove>{{ t('edit.remove_row') }}</button>{% endif %}
          </header>
          {% for subName, subDef in def.fields %}
            {{ _self.field(
                 subDef,
                 id ~ '-' ~ i ~ '-' ~ subName,
                 fname ~ '[' ~ i ~ '][' ~ subName ~ ']',
                 row[subName]|default(''),
                 locked or not may_edit(subDef.editable, role),
                 pages,
                 page_ids,
                 errors|default({})
               ) }}
          {% endfor %}
        </div>
      {% endfor %}
    </div>

    {% if not locked %}
      <button type="button" class="btn ghost" data-row-add="{{ id }}">{{ t('edit.add_row') }}</button>
      {# __INDEX__ is replaced on insert. A <template> keeps the blank row out
         of the form until it is wanted — an empty row that posts is an empty
         row the save path has to refuse. #}
      <template id="{{ id }}-template">
        <div class="repeater-row" data-row>
          <header>
            <strong>{{ t(def.label) }}</strong>
            <button type="button" class="btn ghost" data-row-remove>{{ t('edit.remove_row') }}</button>
          </header>
          {% for subName, subDef in def.fields %}
            {{ _self.field(
                 subDef,
                 id ~ '-__INDEX__-' ~ subName,
                 fname ~ '[__INDEX__][' ~ subName ~ ']',
                 '',
                 not may_edit(subDef.editable, role),
                 pages,
                 page_ids,
                 {}
               ) }}
          {% endfor %}
        </div>
      </template>
    {% endif %}
  </div>
{% endmacro %}

{% block foot %}
{# Every string the script below shows, in one object. Inlining t() into each
   line would mean a translator hunting through JavaScript for them, and one
   escaping mistake away from a broken panel. `%1`/`%2` rather than sprintf,
   because JavaScript has no sprintf and two replaces are not worth a helper. #}
<script>
  const T = {
    linkPrompt: {{ t('rt.link_prompt')|json_encode|raw }},
    uploading: {{ t('edit.uploading')|json_encode|raw }},
    uploadingN: {{ t('edit.uploading_n')|json_encode|raw }},
    uploadFailed: {{ t('up.failed')|json_encode|raw }},
    imageUploaded: {{ t('edit.image_uploaded')|json_encode|raw }},
    videoUploaded: {{ t('edit.video_uploaded')|json_encode|raw }},
    noImage: {{ t('edit.no_image')|json_encode|raw }},
    atLimit: {{ t('edit.at_limit')|json_encode|raw }},
    uploadDone: {{ t('edit.upload_done')|json_encode|raw }},
    uploadSomeFailed: {{ t('edit.upload_some_failed')|json_encode|raw }},
    unsaved: {{ t('edit.unsaved')|json_encode|raw }},
  };
</script>
{# source() reads the file raw instead of rendering it, so the script's braces
   are never parsed as Twig. It is a real .js file for the obvious reason: 260
   lines of JavaScript in a template is 260 lines nothing highlights or lints. #}
<script>{{ source('admin/editor.js') }}</script>
{% endblock %}
