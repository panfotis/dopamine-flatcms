{% set src = value.src|default('') %}
<div class="media">
  <div class="thumb" id="{{ id }}-thumb"
       style="{% if src %}background-image:url('{{ src }}'){% endif %}"></div>
  <div class="controls">
    {% if not locked %}
      <input type="file" id="{{ id }}-file" accept="image/jpeg,image/png,image/webp" hidden>
      <button type="button" class="btn ghost" data-upload="{{ id }}">{{ t('edit.change_image') }}</button>
      <button type="button" class="btn ghost" data-clear="{{ id }}">{{ t('edit.remove') }}</button>
    {% endif %}
    <input type="hidden" id="{{ id }}" name="{{ fname }}[src]" value="{{ src }}">
    <p class="path" id="{{ id }}-path">{{ src ?: t('edit.no_image') }}</p>
  </div>
</div>
{# alt comes with the image field rather than beside it, so a
   new component cannot ship without one. A decorative image
   is declared as such in schema.yml and shows no input at
   all — an empty alt is the right markup for it, and asking
   for one produces "photo" and "logo123.jpg". #}
{% if not def.decorative %}
  {% set altError = errors[fname ~ '[alt]']|default(null) %}
  <div class="field{{ altError ? ' has-error' : '' }}" style="margin-top:12px">
    <label for="{{ id }}-alt">{{ t(def.fields.alt.label) }}</label>
    {# The same rule the save path applies, stated to the
       browser: required exactly when there is an image. No
       validation library — the round trip is the fallback,
       not the mechanism. #}
    <input type="text" id="{{ id }}-alt" name="{{ fname }}[alt]"
           value="{{ value.alt|default('') }}"
           {{ locked ? 'readonly' : '' }}
           {{ src and not locked ? 'required' : '' }}
           {{ altError ? 'aria-invalid="true"' : '' }}
           maxlength="{{ def.fields.alt.max }}" data-max="{{ def.fields.alt.max }}">
    {% if altError %}<p class="err">{{ altError }}</p>{% endif %}
    <p class="hint">{{ t(def.fields.alt.hint) }}</p>
  </div>
{% endif %}
