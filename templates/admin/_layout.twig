<!DOCTYPE html>
<html lang="el">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex,nofollow">
<title>{% block title %}Διαχείριση{% endblock %} — {{ site('name') }}</title>
<style>
  :root{
    --ink:#12141a; --muted:#68707d; --line:#e3e6ea; --soft:#f6f7f9;
    --accent:#1b6ef3; --ok:#0d8a52; --warn:#b45309; --danger:#c02626;
    --radius:10px;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--soft);color:var(--ink);
       font:400 15px/1.55 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  a{color:var(--accent)}
  .topbar{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
  .topbar .inner{max-width:940px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;gap:16px}
  .brand{font-weight:700;letter-spacing:-.01em}
  .brand span{color:var(--muted);font-weight:400}
  .topbar .who{margin-left:auto;color:var(--muted);font-size:13px}
  .wrap{max-width:940px;margin:0 auto;padding:28px 24px 120px}
  h1{font-size:1.6rem;margin:0 0 4px;letter-spacing:-.01em}
  .sub{color:var(--muted);margin:0 0 24px}

  .card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);margin-bottom:16px}
  .card > header{padding:14px 18px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}
  .card > header h2{font-size:1rem;margin:0}
  .card > .body{padding:18px}
  .pill{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);
        background:var(--soft);border:1px solid var(--line);padding:3px 8px;border-radius:99px}
  .hint{color:var(--muted);font-size:13px;margin:2px 0 0}

  .field{margin-bottom:18px}
  .field:last-child{margin-bottom:0}
  label{display:block;font-weight:600;font-size:13px;margin-bottom:6px}
  .counter{float:inline-end;font-weight:400;color:var(--muted)}
  .counter.over{color:var(--danger)}
  input[type=text],input[type=url],textarea,select,.rt{
    width:100%;padding:10px 12px;border:1px solid #cfd4da;border-radius:8px;background:#fff;
    font:inherit;color:inherit}
  textarea{min-height:96px;resize:vertical}
  input:focus,textarea:focus,select:focus,.rt:focus{outline:2px solid var(--accent);outline-offset:-1px;border-color:var(--accent)}
  input[readonly],textarea[readonly]{background:var(--soft);color:var(--muted)}

  .rt{min-height:110px}
  .rt p{margin:0 0 .6em}
  .rt-toolbar{display:flex;gap:4px;margin-bottom:6px}
  .rt-toolbar button{border:1px solid #cfd4da;background:#fff;border-radius:6px;width:32px;height:30px;
    cursor:pointer;font-size:14px;line-height:1}
  .rt-toolbar button:hover{background:var(--soft)}

  .media{display:flex;gap:14px;align-items:flex-start}
  .media .thumb{width:132px;height:92px;border:1px solid var(--line);border-radius:8px;background:var(--soft) center/cover no-repeat;flex:none}
  .media .controls{flex:1;min-width:0}
  .media .path{font-size:12px;color:var(--muted);word-break:break-all;margin-top:6px}

  .btn{display:inline-block;background:var(--accent);color:#fff;border:0;border-radius:8px;
       padding:10px 18px;font:600 14px/1 inherit;cursor:pointer;text-decoration:none}
  .btn.ghost{background:#fff;color:var(--ink);border:1px solid #cfd4da}
  .btn:disabled{opacity:.5;cursor:default}

  .savebar{position:fixed;left:0;right:0;bottom:0;background:#fff;border-top:1px solid var(--line);
           padding:12px 24px;display:flex;gap:12px;align-items:center;z-index:30}
  .savebar .inner{max-width:940px;margin:0 auto;width:100%;display:flex;gap:12px;align-items:center}
  .savebar .status{color:var(--muted);font-size:13px;margin-inline-start:auto}

  .flash{padding:12px 16px;border-radius:8px;margin-bottom:18px;font-size:14px}
  .flash.ok{background:#e7f6ee;color:var(--ok);border:1px solid #b7e2cb}
  .flash.warn{background:#fdf3e3;color:var(--warn);border:1px solid #f0dcb4}
  .flash.err{background:#fdeaea;color:var(--danger);border:1px solid #f3c4c4}

  table{width:100%;border-collapse:collapse;background:#fff}
  th,td{text-align:start;padding:13px 18px;border-bottom:1px solid var(--line)}
  th{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
  tr:last-child td{border-bottom:0}
  code{background:var(--soft);padding:2px 6px;border-radius:5px;font-size:13px}
</style>
</head>
<body>
<div class="topbar"><div class="inner">
  <div class="brand"><a href="?" style="text-decoration:none;color:inherit">{{ site('name') }}</a> <span>· Διαχείριση</span></div>
  <div class="who">{{ user }}</div>
</div></div>

<div class="wrap">{% block content %}{% endblock %}</div>
{% block foot %}{% endblock %}
</body>
</html>
