{% extends '@admin/_layout.twig' %}
{% block title %}{{ t('settings.title') }}{% endblock %}
{% block aside %}{% include '@admin/_nav.twig' with {active: 'settings'} %}{% endblock %}

{# One row per value, at any depth, in one flat table per section. Twig cannot
   see how deep config.php nests — `locales` is two levels, `images.derivatives`
   is three — so the macro calls itself rather than this file repeating a table
   per known shape. A section added to config.php appears here with no edit.

   Keys keep their exact spelling (the layout upper-cases `th` by default):
   you grep config.php for `base_url`, not for BASE_URL. #}
{% macro rows(data, depth) %}
  {% for key, value in data %}
    {% set indent = 24 + depth * 20 %}
    {# A plain list of scalars is one comma-separated line — six derivative
       widths are one fact, not six rows. A list's first key is 0; a map's is a
       string, and in PHP 8 a string is not === 0. #}
    {% set flat = value is iterable and value|keys|first === 0 and value|filter(v => v is iterable) is empty %}
    {% if value is iterable and not flat %}
      <tr>
        <th colspan="2" style="padding-inline-start:{{ indent }}px;text-transform:none;font-size:13px;color:var(--ink)">{{ key }}</th>
      </tr>
      {{ _self.rows(value, depth + 1) }}
    {% else %}
      <tr>
        <th scope="row" style="padding-inline-start:{{ indent }}px;text-transform:none;font-weight:400;width:38%">{{ key }}</th>
        <td>
          {% if value is same as(true) %}<span class="pill">{{ t('settings.on') }}</span>
          {% elseif value is same as(false) %}<span class="pill">{{ t('settings.off') }}</span>
          {% elseif flat %}<code>{{ value|join(', ') }}</code>
          {% elseif value is null or value == '' %}<span style="color:var(--hint)">{{ t('settings.unset') }}</span>
          {% else %}<code>{{ value }}</code>
          {% endif %}
        </td>
      </tr>
    {% endif %}
  {% endfor %}
{% endmacro %}

{% block content %}
  <h1>{{ t('settings.title') }}</h1>
  <p class="sub">
    <a href="?">{{ t('nav.back') }}</a> ·
    {# The product name needs no catalogue entry; the version is the fact this
       screen exists to state, top of page, before any config row. #}
    Dopamine FlatCMS <code>{{ engine }}</code> ·
    {{ t('settings.intro') }}
  </p>

  {# Section headings are the config keys themselves, untranslated: they are
     identifiers a developer greps for, and translating them would mean this
     screen needs a lang entry every time config.php grows a section. #}
  {% for section, values in sections %}
    <div class="card">
      <header><code>{{ section }}</code></header>
      <table>
        {% if values is iterable %}
          {{ _self.rows(values, 0) }}
        {% else %}
          {# A scalar section — `admin_locale`, `twig_cache`. The card header is
             already its name, so the row carries only the value. #}
          <tr><td>
            {% if values is same as(true) %}<span class="pill">{{ t('settings.on') }}</span>
            {% elseif values is same as(false) %}<span class="pill">{{ t('settings.off') }}</span>
            {% elseif values == '' %}<span style="color:var(--hint)">{{ t('settings.unset') }}</span>
            {% else %}<code>{{ values }}</code>{% endif %}
          </td></tr>
        {% endif %}
      </table>
    </div>
  {% endfor %}
{% endblock %}
