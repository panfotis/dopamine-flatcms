{% extends '@admin/_layout.twig' %}
{% block title %}403{% endblock %}

{% block content %}
  <h1>403</h1>
  {# The only page in the panel a refused person sees, so it is a page and not
     a bare fragment: an authenticated client who is simply missing from
     roles.yml is far more likely than an attacker, and an unstyled wall of
     text reads as "the site is broken" rather than "ask for access". #}
  <div class="flash err">{{ message }}</div>
{% endblock %}
