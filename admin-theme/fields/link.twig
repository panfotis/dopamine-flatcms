{# A destination is three decisions: which page, or failing that which
   address, and where it opens. Picking a page stores the page id and
   resolves the slug at render time — so renaming a slug cannot leave a
   dead href behind. The address box is the escape hatch for somewhere
   this site does not own, and it is ignored while a page is picked. #}
{% set page = value.page|default('') %}
{% set url = value.url|default('') %}
{% set target = value.target|default('_self') %}

{# Three controls, one decision — so they sit in one panel rather than reading
   as three consecutive questions about unrelated things. #}
<div class="field-group">
<select id="{{ id }}" name="{{ fname }}[page]" {{ locked ? 'disabled' : '' }}>
  <option value="">{{ t('edit.no_page') }}</option>
  {% for p in pages|default([]) %}
    <option value="{{ p.id }}" {{ page == p.id ? 'selected' : '' }}>{{ p.title }} ({{ p.slug }})</option>
  {% endfor %}
</select>

<div class="field" style="margin-top:12px">
  <label for="{{ id }}-url">{{ t(def.fields.url.label) }}</label>
  <input type="url" id="{{ id }}-url" name="{{ fname }}[url]" value="{{ url }}"
         placeholder="https://…" {{ locked ? 'readonly' : '' }}>
  <p class="hint">{{ t(def.fields.url.hint) }}</p>
</div>

<div class="field" style="margin-top:12px">
  <label for="{{ id }}-target">{{ t(def.fields.target.label) }}</label>
  <select id="{{ id }}-target" name="{{ fname }}[target]" {{ locked ? 'disabled' : '' }}>
    {% for val, label in def.fields.target.options %}
      <option value="{{ val }}" {{ target == val ? 'selected' : '' }}>{{ t(label) }}</option>
    {% endfor %}
  </select>
</div>

{# A disabled control posts nothing, so a locked field would save as empty. #}
{% if locked %}
  <input type="hidden" name="{{ fname }}[page]" value="{{ page }}">
  <input type="hidden" name="{{ fname }}[target]" value="{{ target }}">
{% endif %}

{% if page and page not in page_ids|default([]) %}
  <p class="hint" style="color:#b4232a">
    {{ t('edit.dead_link', page) }}
  </p>
{% endif %}
</div>
