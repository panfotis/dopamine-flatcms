{% extends '@admin/_layout.twig' %}
{% block title %}{{ t('sub.title') }}{% endblock %}
{% block aside %}{% include '@admin/_nav.twig' with {active: 'messages'} %}{% endblock %}

{% block content %}
  <h1>{{ t('sub.title') }}</h1>
  <p class="sub">
    <a href="?">{{ t('nav.back') }}</a> ·
    {{ t('sub.retention', retain) }}
  </p>

  {% if notice %}<div class="flash ok">{{ notice }}</div>{% endif %}
  {% if warn %}<div class="flash warn">{{ warn }}</div>{% endif %}

  <div class="card">
    <table>
      <tr><th>{{ t('sub.when') }}</th><th>{{ t('sub.from') }}</th><th>{{ t('sub.status') }}</th><th></th></tr>
      {% for s in submissions %}
        <tr>
          <td>{{ s.at|date('d/m/Y H:i') }}</td>
          {# Whatever the form called its first input. The panel does not
             assume a field named "name" exists, because the inputs are the
             developer's and differ per site. #}
          <td>{{ s.values|first|default('—')|slice(0, 40) }}{{ s.values|first|default('')|length > 40 ? '…' : '' }}</td>
          <td>
            {% if s.status == 'sent' %}<span class="pill">{{ t('sub.sent') }}</span>
            {% elseif s.status == 'review' %}
              {# Ambiguous transport error: it may well have arrived, so it is
                 never retried automatically. Someone has to look. #}
              <span class="pill" style="color:var(--warn)">{{ t('sub.review') }}</span>
            {% else %}<span class="pill" style="color:var(--danger)">{{ t('sub.unsent') }}</span>{% endif %}
            {% if s.attempts > 1 %}<span class="pill">{{ t('sub.attempts', s.attempts) }}</span>{% endif %}
          </td>
          <td style="text-align:end">
            <a class="btn ghost" href="?action=submission&amp;month={{ s.month }}&amp;id={{ s.id }}">{{ t('sub.open') }}</a>
          </td>
        </tr>
      {% else %}
        <tr><td colspan="4">{{ t('sub.empty') }}</td></tr>
      {% endfor %}
    </table>
  </div>
{% endblock %}
