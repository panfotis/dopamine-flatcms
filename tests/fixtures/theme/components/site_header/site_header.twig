{# Component: site_header — placed in _header.yml, so it renders on every page.

   `nav` and `page` arrive exactly as they do in a page block: this template has
   no idea it was rendered from a different file, and does not need one. #}
<div class="site-head">
  <div class="wrap">
    <a class="brand" href="{{ home_url }}">
      {% if fields.logo.src|default('') %}
        {% include 'picture.twig' with {
             image: fields.logo,
             widths: [640],
             sizes: '200px',
             lazy: false
           } only %}
      {% else %}
        {{ site('name') }}
      {% endif %}
    </a>

    {# Order comes from each page's `nav:` key, not from the slug sort
       Content::list() happens to return. A page with no `nav:` is not in the
       menu — which is how a landing page stays reachable but unlisted. #}
    {% if nav %}
      <nav class="site-nav" aria-label="{{ fields.nav_label }}">
        {# Against page.url, not page.slug: on a prefixed language the menu
           links carry the prefix and the stored slug does not. #}
        {% for item in nav %}
          <a href="{{ item.url }}"{{ item.url == page.url ? ' aria-current="page"' : '' }}>{{ item.label }}</a>
        {% endfor %}
      </nav>
    {% endif %}

    {# Nothing to switch between on a single-language site, so nothing renders.
       A language with no translation of this page still appears, pointing at
       its home page — being offered fewer languages on some pages than on
       others reads as a broken site. #}
    {% if alternates|default([])|length > 1 %}
      <nav class="lang-switch" aria-label="{{ fields.lang_label }}">
        {% for alt in alternates %}
          <a href="{{ alt.url }}" hreflang="{{ alt.locale }}" lang="{{ alt.locale }}"
             {{- alt.current ? ' aria-current="true"' : '' }}>{{ alt.label }}</a>
        {% endfor %}
      </nav>
    {% endif %}
  </div>
</div>
