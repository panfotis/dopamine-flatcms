{#
  A page with no header and no footer: a landing page, a page that has to open
  inside someone else's iframe, a thank-you page nobody should navigate away
  from. Chosen per page with `layout: bare` in the page file.

  The head is head.twig, the same file layout.twig includes, so this layout can
  never fall behind on an og: tag or a tracking script — which matters most
  here, of all places, since this is the layout an ad campaign lands on.
  The absent header and footer are the whole difference.
#}
<!DOCTYPE html>
<html lang="{{ locale|default(site('locale')) }}">
<head>
{% include ['head.twig', '@flatcms/head.twig'] %}
</head>
<body>
{# No header_blocks and no footer_blocks: that is the whole difference. #}
<main>
  {% for block in blocks %}{{ block|raw }}{% endfor %}
</main>
{{ theme_foot() }}
</body>
</html>
