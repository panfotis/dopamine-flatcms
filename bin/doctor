#!/usr/bin/env php
<?php

/**
 * Everything that can be wrong with a site without anyone noticing until a
 * client does.
 *
 * Runs before the first deploy and before every one after it, against the
 * *shared* content a release is about to be pointed at. A deploy whose doctor
 * fails never switches `current`, which is the whole reason this exists: the
 * failures below are the ones that produce a white page, a broken image or a
 * silently unreachable page rather than an obvious error.
 *
 *   bin/doctor            check and report
 *   bin/doctor --quiet    exit code only, for cron
 *
 * Exit 0 clean, 1 if anything is wrong. Warnings do not fail the run.
 */

declare(strict_types=1);

use Dopamine\FlatCms\Cms;
use Dopamine\FlatCms\Content;
use Symfony\Component\Yaml\Yaml;

$autoload = $GLOBALS['_composer_autoload_path'] ?? dirname(__DIR__) . '/vendor/autoload.php';
require $autoload;

// Composer's bin proxy runs this file from vendor/dopamine/flatcms/bin while
// the site's config remains at the project root. Direct source checkouts keep
// working because their current directory also contains config.php.
$siteRoot = getenv('DOPAMINE_SITE_ROOT') ?: getcwd();
$configFile = $siteRoot . '/config.php';
if (!is_file($configFile)) {
    $configFile = dirname(__DIR__) . '/config.php';
}

$quiet = in_array('--quiet', $argv, true);

/** @var list<array{0: string, 1: string}> */
$problems = [];
$warnings = [];

$fail = static function (string $what) use (&$problems): void {
    $problems[] = $what;
};
$warn = static function (string $what) use (&$warnings): void {
    $warnings[] = $what;
};

// ── Config and paths ────────────────────────────────────────────────────────

try {
    $config = require $configFile;
} catch (Throwable $e) {
    // The production boot guard throws here, which is the point: a box that
    // refuses to serve must also fail its own health check rather than pass it.
    fwrite(STDERR, "config.php refuses to load:\n" . $e->getMessage() . "\n");
    exit(1);
}

$cms = new Cms($config);

foreach (['content', 'theme', 'admin_theme'] as $key) {
    foreach ((array) $config['paths'][$key] as $dir) {
        if (!is_dir((string) $dir)) {
            $fail(sprintf('paths.%s does not exist: %s', $key, $dir));
        }
    }
}

// Writable, not merely present: the panel writes pages, revisions, uploads,
// locks and the derivative cache, and every one of those fails at the worst
// possible moment — mid-save, with the client watching.
foreach ([
    'content'          => $config['paths']['content'],
    'content/uploads'  => $config['paths']['uploads'],
    'var/cache'        => $config['paths']['cache'],
    'var/locks'        => dirname($config['paths']['cache']) . '/locks',
] as $label => $dir) {
    // Runtime directories are created recursively. On a clean checkout both
    // `var` and its children may be absent, so find the nearest ancestor PHP
    // would actually need permission to write into rather than stopping after
    // one dirname() call at another path that does not exist yet.
    while (!is_dir($dir) && dirname($dir) !== $dir) {
        $dir = dirname($dir);
    }
    if (!is_dir($dir) || !is_writable($dir)) {
        $fail(sprintf('%s is not writable by this user: %s', $label, $dir));
    }
}

// Every absolute URL the site publishes is built from this: the sitemap's
// <loc>, og:image, the Sitemap: line in robots.txt. A production box still
// carrying the development default submits a sitemap full of localhost, and
// nothing about that is visible until months of nothing being indexed.
$baseUrl = (string) $config['site']['base_url'];
if ($baseUrl === '' || preg_match('#^https?://(localhost|127\.|\[?::1)#i', $baseUrl) === 1) {
    $where = 'site.base_url is ' . ($baseUrl ?: 'empty')
        . ' — sitemap.xml and og:image URLs are built from it';

    if (getenv('APP_ENV') === 'prod') {
        $fail($where);
    } else {
        $warn($where);
    }
}

// Disk, because every failure mode of a full one is silent and awful: a save
// writes a truncated page, the derivative cache stops filling, git commits
// nothing. Run from cron with --quiet this is the disk monitor.
$free = @disk_free_space($config['paths']['content']);
$total = @disk_total_space($config['paths']['content']);
if (is_float($free) && is_float($total) && $total > 0) {
    $used = 1 - ($free / $total);
    $pct = round($used * 100);
    if ($used > 0.95) {
        $fail(sprintf('disk is %d%% full — saves will start truncating', $pct));
    } elseif ($used > 0.85) {
        $warn(sprintf('disk is %d%% full', $pct));
    }
}

// The derivative cache is bounded by config, but only if pruning is running.
// Well past the ceiling means it is not.
$cacheDir = $config['paths']['cache'] . '/images';
if (is_dir($cacheDir)) {
    $bytes = 0;
    foreach (glob($cacheDir . '/*') ?: [] as $file) {
        $bytes += (int) @filesize($file);
    }
    $ceiling = (int) $config['images']['derivatives']['cache_max_bytes'];
    if ($ceiling > 0 && $bytes > $ceiling * 1.5) {
        $warn(sprintf(
            'the derivative cache is %d MB against a %d MB ceiling — pruning is not keeping up',
            intdiv($bytes, 1024 * 1024),
            intdiv($ceiling, 1024 * 1024)
        ));
    }
}

// Checked against the *running* interpreter, not against composer.json.
// Composer resolved these under the CLI php; php-fpm can be a different build
// with a different extension set, and that difference only ever shows up as a
// fatal on the one request that needs it.
foreach (['curl', 'dom', 'exif', 'fileinfo', 'gd', 'json', 'openssl'] as $ext) {
    if (!extension_loaded($ext)) {
        $fail('required PHP extension missing: ext-' . $ext);
    }
}

// ── Production auth ─────────────────────────────────────────────────────────
//
// config.php's boot guard already refuses to start on these, but only when
// APP_ENV=prod is actually set. Checking here catches the box where it is not.

if (getenv('APP_ENV') === 'prod') {
    if ((bool) ini_get('display_errors')) {
        $fail('display_errors is on in production — a stack trace is a public page');
    }
} else {
    $warn('APP_ENV is not "prod": the auth boot guard is inert on this box');
}

if ($config['auth']['mode'] === 'none') {
    $warn('auth.mode is "none" — the panel is wide open (fine locally, never in production)');
}
if ($config['auth']['dev_bypass'] === true) {
    $warn('AUTH_DEV_BYPASS=1 — authentication is skipped entirely on this box');
}
if (!is_file((string) $config['auth']['roles_file'])) {
    $fail('roles file missing: ' . $config['auth']['roles_file'] . ' — every address would be refused');
}

// ── Components ──────────────────────────────────────────────────────────────

$types = [];
$componentDirs = [];
foreach ((array) $config['paths']['theme'] as $root) {
    foreach (glob((string) $root . '/components/*', GLOB_ONLYDIR) ?: [] as $dir) {
        $componentDirs[basename($dir)] ??= $dir;
    }
}
foreach ($componentDirs as $type => $dir) {
    $types[] = $type;

    if (!is_file($dir . '/schema.yml')) {
        $fail(sprintf('component "%s" has no schema.yml', $type));
        continue;
    }
    if (!is_file($dir . '/' . $type . '.twig')) {
        $fail(sprintf('component "%s" has no %s.twig — every block of it would vanish from the page', $type, $type));
    }

    try {
        $schema = Yaml::parseFile($dir . '/schema.yml');
    } catch (Throwable $e) {
        $fail(sprintf('component "%s": schema.yml is not valid YAML (%s)', $type, $e->getMessage()));
        continue;
    }

    foreach ((array) ($schema['fields'] ?? []) as $name => $def) {
        $def = is_array($def) ? $def : ['type' => $def];
        $fieldType = (string) ($def['type'] ?? 'text');

        if (!in_array($fieldType, Dopamine\FlatCms\Fields::TYPES, true)) {
            $fail(sprintf('component "%s", field "%s": unknown type "%s"', $type, $name, $fieldType));
        }
        // Silently locking a field is the fail-closed behaviour Components
        // applies, and it is right — but it is also invisible, so say it here.
        if (array_key_exists('editable', $def)
            && !in_array($def['editable'], Dopamine\FlatCms\Components::EDITABLE, true)) {
            $fail(sprintf(
                'component "%s", field "%s": editable: %s is not one of true/false/admin, so the field is locked',
                $type,
                $name,
                var_export($def['editable'], true)
            ));
        }
        if ($fieldType === 'list') {
            if (!is_array($def['fields'] ?? null) || $def['fields'] === []) {
                $fail(sprintf('component "%s", field "%s": a list needs a `fields` sub-schema', $type, $name));
            }
            if (!is_int($def['max'] ?? null) || (int) $def['max'] <= 0) {
                $warn(sprintf(
                    'component "%s", field "%s": no `max`, so the built-in ceiling applies',
                    $type,
                    $name
                ));
            }
        }
        if ($fieldType === 'select' && Dopamine\FlatCms\Fields::options($def) === []) {
            $fail(sprintf('component "%s", field "%s": a select with no options', $type, $name));
        }
    }
}

// A template that cannot compile is a white page on the pages that use it, and
// nothing before this point would have noticed.
//
// all() parses every schema.yml, so it throws on the malformed one already
// reported above. Catching keeps doctor a report rather than a crash — a health
// check that dies on the first problem tells you about one problem.
$componentsLoad = true;

try {
    $loaded = $cms->components->all();
} catch (Throwable $e) {
    $loaded = [];
    $componentsLoad = false;
    $warn('component templates and page links not checked: a schema failed to parse (' . $e->getMessage() . ')');
}

foreach ($loaded as $type => $schema) {
    try {
        $cms->twig->load($schema['template']);
    } catch (Throwable $e) {
        $fail(sprintf('component "%s": %s does not compile — %s', $type, $schema['template'], $e->getMessage()));
    }
}

// A form input is an HTML name and shares the request namespace with the
// engine's controls. Letting a schema claim one of these makes the form either
// permanently fail CSRF or trip its own honeypot.
$formReserved = ['csrf', 'website', 'consent', 'action', 'cf_turnstile_response'];
foreach ($loaded as $type => $schema) {
    foreach ((array) ($schema['form'] ?? []) as $name => $def) {
        $normal = str_replace('-', '_', strtolower((string) $name));
        if (preg_match('/^[a-z0-9_]+$/i', (string) $name) !== 1) {
            $fail(sprintf('component "%s", form input "%s": name must contain only letters, numbers and underscores', $type, $name));
        } elseif (in_array($normal, $formReserved, true)) {
            $fail(sprintf('component "%s", form input "%s": name is reserved by the form engine', $type, $name));
        }

        $def = is_array($def) ? $def : [];
        if (!in_array((string) ($def['type'] ?? 'text'), ['text', 'email', 'tel', 'textarea'], true)) {
            $fail(sprintf('component "%s", form input "%s": unknown visitor input type "%s"', $type, $name, $def['type'] ?? ''));
        }
    }
}

foreach (['layout.twig', '404.twig', '500.twig', 'picture.twig'] as $template) {
    $exists = false;
    foreach ((array) $config['paths']['theme'] as $root) {
        if (is_file((string) $root . '/' . $template)) {
            $exists = true;
            break;
        }
    }
    if (!$exists) {
        $fail('missing template: ' . $template);
        continue;
    }
    try {
        $cms->twig->load($template);
    } catch (Throwable $e) {
        $fail(sprintf('%s does not compile — %s', $template, $e->getMessage()));
    }
}

// ── Theme assets ────────────────────────────────────────────────────────────

$themeDirs = array_values(array_filter((array) $config['paths']['theme'], 'is_string'));
$adminDirs = array_values(array_filter((array) ($config['paths']['admin_theme'] ?? []), 'is_string'));

// Every local CSS file the pipeline will inline, and every manifest entry.
// Collected once so the reference checks below run over one list.
$localCss  = [];
$localJs   = [];
$externals = [];   // url => [where, attrs]

$collectManifest = static function (string $dir, string $who) use (&$localCss, &$localJs, &$externals, $fail, $warn): void {
    $file = $dir . '/theme.yml';
    if (!is_file($file)) {
        return;
    }
    try {
        $data = (array) (Yaml::parseFile($file) ?? []);
    } catch (Throwable $e) {
        $fail(sprintf('%s: theme.yml is not valid YAML (%s)', $who, $e->getMessage()));

        return;
    }

    foreach (['css', 'js'] as $kind) {
        foreach ((array) ($data[$kind] ?? []) as $entry) {
            if (is_array($entry)) {
                $url = (string) ($entry['url'] ?? '');
                if ($url === '') {
                    $fail(sprintf('%s: external %s entry has no url', $who, $kind));
                } else {
                    $externals[] = [$who, $kind, $url, $entry];
                }
                continue;
            }
            $entry = (string) $entry;
            if (str_starts_with($entry, 'https://')) {
                $externals[] = [$who, $kind, $entry, ['url' => $entry]];
                continue;
            }
            if (preg_match('#^(https?:)?//#i', $entry) === 1) {
                $fail(sprintf('%s: %s is not https — the pipeline refuses it', $who, $entry));
                continue;
            }
            // A local path: it must exist, and it must resolve inside the
            // theme layer that declared it — ../../.env inlined into a public
            // page is the failure this check exists for.
            $real = realpath($dir . '/' . $entry);
            $root = realpath($dir);
            if ($real === false) {
                $fail(sprintf('%s: %s does not exist', $who, $entry));
            } elseif ($root === false || str_starts_with($entry, '/') || !str_starts_with($real, $root . '/')) {
                $fail(sprintf('%s: %s resolves outside its own theme root', $who, $entry));
            } elseif ($kind === 'css') {
                $localCss[] = [$who, $real];
            } else {
                $localJs[] = [$who, $real];
            }
        }
    }
};

foreach ($themeDirs as $dir) {
    $collectManifest($dir, 'theme ' . $dir);
}
foreach ($adminDirs as $dir) {
    $collectManifest($dir, 'admin-theme ' . $dir);
}

foreach ($componentDirs as $type => $dir) {
    // Convention files: <type>.css / <type>.js are picked up automatically —
    // any other stray .css/.js in the folder never will be.
    foreach (glob($dir . '/*.{css,js}', GLOB_BRACE) ?: [] as $file) {
        $base = basename($file);
        if (!in_array($base, [$type . '.css', $type . '.js'], true)) {
            $warn(sprintf('component "%s": %s will never be picked up — the convention is %s.css / %s.js', $type, $base, $type, $type));
        } elseif (str_ends_with($base, '.css')) {
            $localCss[] = ['component ' . $type, (string) realpath($file)];
        } else {
            $localJs[] = ['component ' . $type, (string) realpath($file)];
        }
    }

    // External deps from the schema. Local paths do not belong here — the
    // convention file beside the template is the whole declaration.
    try {
        $schema = $cms->components->get($type) ?? [];
    } catch (Throwable) {
        continue; // an unparseable schema.yml is already reported above
    }

    // A form's security inputs are validated by name in Form::handle(). A
    // rewritten template that drops the CSRF token fails loudly; one that
    // drops the honeypot fails *silently* — spam gets in and nothing ever
    // says so. Compiled source, not strpos: a commented-out form_guards()
    // does not count.
    if ((array) ($schema['form'] ?? []) !== []) {
        try {
            $compiled = $cms->twig->compileSource(
                $cms->twig->getLoader()->getSourceContext((string) $schema['template'])
            );
            if (!str_contains($compiled, 'form_guards')
                && !(str_contains($compiled, 'name="csrf"') && str_contains($compiled, 'name="website"'))) {
                $fail(sprintf(
                    'component "%s" declares form: but renders neither form_guards() nor both the csrf and honeypot inputs — submissions would be rejected, or spam silently accepted',
                    $type
                ));
            }
        } catch (Throwable) {
            // a missing or broken template is reported above
        }
    }
    foreach (['css', 'js'] as $kind) {
        foreach ((array) ($schema['assets'][$kind] ?? []) as $entry) {
            $entry = is_array($entry) ? $entry : ['url' => (string) $entry];
            $url = (string) ($entry['url'] ?? '');
            if ($url === '' || !str_starts_with($url, 'https://')) {
                $fail(sprintf('component "%s": assets.%s entry must be an https url', $type, $kind));
            } else {
                $externals[] = ['component ' . $type, $kind, $url, $entry];
            }
        }
    }
}

// The same URL declared twice must agree on everything — integrity, async,
// crossorigin, even which of css:/js: it sits under. Picking one silently is
// the failure mode; runtime keeps the first and this is where it gets loud.
$seenUrl = [];
$hasAsync = false;
foreach ($externals as [$who, $kind, $url, $attrs]) {
    unset($attrs['url']);
    ksort($attrs);
    $shape = $kind . '|' . json_encode($attrs);
    if (isset($seenUrl[$url]) && $seenUrl[$url] !== $shape) {
        $fail(sprintf('%s: %s is declared twice with different attributes', $who, $url));
    }
    $seenUrl[$url] ??= $shape;

    if (($attrs['integrity'] ?? '') === '') {
        $warn(sprintf('%s: %s has no integrity hash — pin to a tag and add one', $who, $url));
    }
    if (($attrs['async'] ?? false) === true) {
        $hasAsync = true;
    }
}
if ($hasAsync && $localJs !== []) {
    $warn('an async external script coexists with local JS — async has no ordering guarantee against DOMContentLoaded, so local code must not depend on it');
}

// Inlined CSS has no file URL to resolve against: a relative url() or @import
// silently requests the wrong path on every page. data:, https:, /… and #…
// survive inlining; nothing else does.
foreach ($localCss as [$who, $file]) {
    $css = (string) @file_get_contents($file);
    foreach ((array) (preg_match_all('#url\(\s*[\'"]?([^\'")\s]+)#i', $css, $m) ? $m[1] : []) as $ref) {
        if (preg_match('~^(data:|https://|/|\#)~', $ref) !== 1) {
            $fail(sprintf('%s: relative url(%s) cannot resolve once inlined', $who, $ref));
        }
    }
    foreach ((array) (preg_match_all('#@import\s+(?:url\()?[\'"]?([^\'")\s;]+)#i', $css, $m) ? $m[1] : []) as $ref) {
        if (str_starts_with($ref, 'https://')) {
            $warn(sprintf('%s: @import %s is a serialized second round-trip — declare it in the manifest as a <link> instead', $who, $ref));
        } else {
            $fail(sprintf('%s: relative @import %s cannot resolve once inlined', $who, $ref));
        }
    }
}

// A site layer that overrides a panel template tracks engine internals it
// cannot see change. Assets are the supported branding surface.
$engineAdmin = $adminDirs !== [] ? $adminDirs[count($adminDirs) - 1] : null;
foreach (array_slice($adminDirs, 0, -1) as $dir) {
    foreach (glob($dir . '/{,fields/}*.twig', GLOB_BRACE) ?: [] as $file) {
        $warn(sprintf('admin-theme override %s: panel templates change shape between engine versions — brand via assets/ instead', substr($file, strlen($dir) + 1)));
    }
}

// The two calls that load every stylesheet and script live in templates the
// site owns, so the engine cannot correct them later. Compiled source, not
// strpos: a {# theme_head() #} comment is stripped at compile and stray
// spacing inside the call does not matter.
$pipelined = ['layout.twig', 'bare.twig', '404.twig'];
$checkPipelined = static function () use (&$pipelined, $cms, $fail, $warn): void {
    foreach ($pipelined as $template) {
        try {
            $source   = $cms->twig->getLoader()->getSourceContext($template);
            $compiled = $cms->twig->compileSource($source);
        } catch (Throwable) {
            continue; // missing or broken templates are reported above
        }
        if (!str_contains($compiled, 'theme_head')) {
            $fail(sprintf('%s never calls theme_head() — every page it renders ships without CSS', $template));
        }
        if (!str_contains($compiled, 'theme_foot')) {
            $warn(sprintf('%s never calls theme_foot() — no JS will load on it', $template));
        }
    }
};

// ── Pages ───────────────────────────────────────────────────────────────────

$stray = glob($config['paths']['content'] . '/pages/*.yml') ?: [];
if ($stray !== []) {
    $fail(sprintf(
        '%d page(s) sitting outside a locale directory and therefore unreachable: %s',
        count($stray),
        implode(', ', array_map('basename', $stray))
    ));
}

// The locale map itself, before anything is read through it. Each of these is
// a config mistake that produces a site which serves — just not the one that
// was meant.
$defaults = array_keys(array_filter($cms->locales(), static fn (array $d): bool => $d['default']));
if (count($defaults) !== 1) {
    $fail(sprintf('locales: exactly one must be `default: true` (found %d)', count($defaults)));
}

$prefixes = [];
foreach ((array) ($config['locales'] ?? []) as $code => $def) {
    $def = (array) $def;
    $prefix = rtrim((string) ($def['prefix'] ?? ''), '/');

    if (($def['default'] ?? false) === true && isset($def['fallback'])) {
        // There is nothing for the default language to fall back *to*.
        $fail(sprintf('locale "%s": is the default and must not carry a fallback', $code));
    }
    if (($def['default'] ?? false) !== true && $prefix === '') {
        // Resolution is by prefix, so a second empty prefix is a page nobody
        // can reach rather than a language served at the root.
        $fail(sprintf('locale "%s": needs a URL prefix — only the default language may have none', $code));
    }
    if ($prefix !== '' && !preg_match('#^/[a-z0-9-]+$#i', $prefix)) {
        $fail(sprintf('locale "%s": prefix must look like "/en" (got "%s")', $code, $prefix));
    }
    if (isset($prefixes[$prefix])) {
        $fail(sprintf('locales "%s" and "%s" share the prefix "%s"', $prefixes[$prefix], $code, $prefix));
    }
    $prefixes[$prefix] = $code;

    if (!is_dir($config['paths']['content'] . '/pages/' . $code)) {
        $fail(sprintf('locale "%s": no content/pages/%s directory', $code, $code));
    }
}

// Every language's files, walked with the identical checks. `$byLocale` is
// what the link check and the translation diff below read.
$byLocale = [];
// Every live URL on the site, prefix included, across every language — which
// is what a redirect has to land on and what one may not shadow.
$liveUrls = [];
foreach (array_keys($cms->locales()) as $localeCode) {
    $cms->useLocale($localeCode);
    $pagesDir = $cms->content->pagesDir();
    if (!is_dir($pagesDir)) {
        continue; // already reported above
    }

$slugs = [];
$ids = [];
$routable = [];
$globals = [];
foreach (glob($pagesDir . '/*.yml') ?: [] as $file) {
    $id = basename($file, '.yml');
    $ids[] = $id;

    try {
        $data = Yaml::parseFile($file);
    } catch (Throwable $e) {
        $fail(sprintf('page "%s": not valid YAML (%s)', $id, $e->getMessage()));
        continue;
    }
    // A YAML *list* is an array too, so is_array() alone would wave through a
    // file that parses fine and then hands templates nothing they expect.
    if (!is_array($data) || array_is_list($data)) {
        $fail(sprintf('page "%s": is not a mapping', $id));
        continue;
    }

    // A global — `_header`, `_footer` — renders inside every page rather than
    // at an address of its own, so it carries no slug to check and cannot
    // collide with one. Everything below this still applies to it: its blocks
    // are validated exactly like a page's.
    if (Content::isGlobal($id)) {
        $globals[] = $id;

        if (isset($data['slug'])) {
            $fail(sprintf('global "%s": carries a slug, but a global is never routed', $id));
        }
    } else {
        $routable[] = $id;

        $slug = (string) ($data['slug'] ?? '');
        if ($slug === '' || !str_starts_with($slug, '/')) {
            $fail(sprintf('page "%s": slug must start with "/" (got "%s")', $id, $slug));
        }
        $key = rtrim($slug, '/') ?: '/';
        if (isset($slugs[$key])) {
            // findBySlug returns the first match, so the second page is simply
            // unreachable — with no error anywhere to say why.
            $fail(sprintf('pages "%s" and "%s" share the slug "%s"', $slugs[$key], $id, $slug));
        }
        $slugs[$key] = $id;
        $liveUrls[rtrim($cms->localeUrl($slug), '/') ?: '/'] = $localeCode . '/' . $id;
    }

    $seen = [];
    $formBlocks = 0;
    foreach ((array) ($data['blocks'] ?? []) as $i => $block) {
        if (!is_array($block)) {
            $fail(sprintf('page "%s": block %d is not a mapping', $id, $i));
            continue;
        }

        $blockId = (string) ($block['id'] ?? '');
        $type = (string) ($block['type'] ?? '');

        if ($blockId === '') {
            $fail(sprintf('page "%s": block %d has no id', $id, $i));
        } elseif (isset($seen[$blockId])) {
            // The panel names inputs by block id, so duplicates mean one form
            // field silently overwrites another on save.
            $fail(sprintf('page "%s": duplicate block id "%s"', $id, $blockId));
        }
        $seen[$blockId] = true;

        if (!in_array($type, $types, true)) {
            $fail(sprintf('page "%s": block "%s" is type "%s", which has no component', $id, $blockId, $type));
        } elseif ((array) ($loaded[$type]['form'] ?? []) !== []) {
            $formBlocks++;
        }
    }

    if ($formBlocks > 1) {
        $fail(sprintf('page "%s": carries %d forms; only one form per page is supported', $id, $formBlocks));
    }
    if ($formBlocks === 1 && ($data['private'] ?? false) !== true) {
        $fail(sprintf('page "%s": carries a form and must declare private: true', $id));
    }

    // A `layout:` that does not resolve renders in layout.twig instead —
    // correct at request time, and silent everywhere else. This is where it
    // gets said, before a landing page ships with a header nobody wanted.
    $layout = (string) ($data['layout'] ?? '');
    $layoutExists = false;
    foreach ((array) $config['paths']['theme'] as $root) {
        if (is_file((string) $root . '/' . $layout . '.twig')) {
            $layoutExists = true;
            break;
        }
    }
    if (in_array($layout, ['picture', 'video_facade'], true)) {
        $warn(sprintf('page "%s": layout "%s" names a partial, not a layout', $id, $layout));
    }
    if ($layout !== '' && !$layoutExists) {
        $warn(sprintf('page "%s": layout "%s" has no template — it will render in layout.twig', $id, $layout));
    }
    if ($layout !== '' && $layoutExists && $layout !== '500'
        && !in_array($layout, ['picture', 'video_facade'], true)
        && !in_array($layout . '.twig', $pipelined, true)) {
        $pipelined[] = $layout . '.twig';
    }

    if (isset($data['nav']) && !is_array($data['nav'])) {
        $fail(sprintf('page "%s": nav: must be a mapping of label and order', $id));
    }

    // A `seo:` of the wrong shape is read as `$data['seo']['noindex']` on the
    // sitemap path and as a value map by the panel; both quietly get nothing.
    if (isset($data['seo']) && (!is_array($data['seo']) || array_is_list($data['seo']))) {
        $fail(sprintf('page "%s": seo: must be a mapping', $id));
    }
}

// A missing global is a site with no menu or no footer on every page at once —
// and Cms::renderGlobal() renders an empty region rather than fatalling, which
// is right at request time and silent everywhere else. This is where it is said.
foreach (['_header', '_footer'] as $required) {
    if (!in_array($required, $globals, true)) {
        $warn(sprintf('locale "%s": no %s.yml — nothing renders in that region', $localeCode, $required));
    }
}

    $byLocale[$localeCode] = ['ids' => $ids, 'routable' => $routable, 'globals' => $globals];
}

// The translation diff. The filename *is* the translation identity, so a page
// that exists in one language and not another is a set difference over a
// directory listing — mechanically checkable before a deploy, which a
// free-text key inside a file never was.
$everyId = array_unique(array_merge(...array_map(
    static fn (array $set): array => $set['ids'],
    array_values($byLocale)
) ?: [[]]));
sort($everyId);

foreach ($byLocale as $code => $set) {
    foreach (array_diff($everyId, $set['ids']) as $missing) {
        $warn(sprintf('locale "%s": no translation of page "%s"', $code, $missing));
    }
}

// Every `link` field on every page: an id that no longer resolves renders as
// plain text, which is correct behaviour and invisible from the outside.
foreach ($byLocale as $localeCode => $set) {
    $cms->useLocale($localeCode);
foreach ($componentsLoad ? $set['ids'] : [] as $id) {
    try {
        $page = $cms->content->load($id);
    } catch (Throwable) {
        continue; // already reported as malformed above
    }

    foreach ((array) ($page['blocks'] ?? []) as $block) {
        $schema = $cms->components->get((string) $block['type']);
        if ($schema === null) {
            continue;
        }
        foreach ($schema['fields'] as $name => $def) {
            if (($def['type'] ?? '') !== 'link') {
                continue;
            }
            // A link stores a map now, a bare id in files saved before that;
            // the check is about the page half either way.
            $stored = $block['fields'][$name] ?? '';
            $target = is_array($stored) ? (string) ($stored['page'] ?? '') : (string) $stored;
            // Against the routable ids, not every file: pageUrl() resolves
            // through Content::list(), so a link pointing at `_footer` renders
            // as plain text exactly like a link to a page that was deleted.
            if ($target !== '' && !in_array($target, $set['routable'], true)) {
                $warn(sprintf(
                    'locale "%s", page "%s", block "%s", field "%s": links to page id "%s", which does not exist',
                    $localeCode,
                    $id,
                    $block['id'],
                    $name,
                    $target
                ));
            }
        }
    }
}
}

$checkPipelined();

// ── Panel language ──────────────────────────────────────────────────────────

// A translation that has fallen behind renders English on some screens and the
// site's language on others, which reads as a broken panel rather than a
// missing string. This is the only place anyone finds out before a client does.
$panel = $cms->lang;
if ($panel->keys() === []) {
    $fail('no lang/' . Dopamine\FlatCms\Lang::SOURCE . '.php — the panel has no source catalogue');
} elseif ($panel->locale() !== Dopamine\FlatCms\Lang::SOURCE) {
    $behind = $panel->missing();
    if ($behind !== []) {
        $warn(sprintf(
            'panel language "%s" is missing %d string(s), which will render in %s: %s',
            $panel->locale(),
            count($behind),
            Dopamine\FlatCms\Lang::SOURCE,
            implode(', ', array_slice($behind, 0, 8)) . (count($behind) > 8 ? '…' : '')
        ));
    }
}

// ── Redirects ───────────────────────────────────────────────────────────────

// redirects.yml is one file for the whole site, and a bare page id in it is a
// default-language page — so ask pageUrl() from there rather than from
// whichever language the loop above happened to finish in.
$cms->useLocale($cms->defaultLocale());

$redirectFile = $config['paths']['content'] . '/redirects.yml';
if (is_file($redirectFile)) {
    try {
        $redirects = Yaml::parseFile($redirectFile);
    } catch (Throwable $e) {
        $redirects = null;
        $fail('redirects.yml is not valid YAML: ' . $e->getMessage());
    }

    if ($redirects !== null && (!is_array($redirects) || array_is_list($redirects))) {
        $fail('redirects.yml must be a mapping of "from: to"');
        $redirects = [];
    }

    foreach ((array) $redirects as $from => $to) {
        $from = '/' . trim((string) $from, '/');
        $to = (string) $to;

        if (isset($liveUrls[rtrim($from, '/') ?: '/'])) {
            // The redirect is checked only after findBySlug misses, so this one
            // can never fire — and whoever wrote it believes it does.
            $fail(sprintf('redirect "%s" shadows a live page and can never fire', $from));
        }

        $resolved = str_starts_with($to, 'http') ? $to
            : (str_starts_with($to, '/') ? $to : ($cms->pageUrl($to) ?: null));

        if ($resolved === null) {
            $fail(sprintf('redirect "%s" points at page id "%s", which does not exist', $from, $to));
            continue;
        }
        if (str_starts_with($resolved, '/') && $resolved === $from) {
            $fail(sprintf('redirect "%s" points at itself', $from));
            continue;
        }
        // One hop only, so a target that is itself a redirect is a 301 into a
        // 301 at best and a loop at worst.
        if (str_starts_with($resolved, '/') && $cms->redirectFor($resolved) !== null) {
            $fail(sprintf('redirect "%s" -> "%s" chains into another redirect', $from, $resolved));
        }
        if (str_starts_with($resolved, '/') && !isset($liveUrls[rtrim($resolved, '/') ?: '/'])) {
            $fail(sprintf('redirect "%s" -> "%s" lands on nothing', $from, $resolved));
        }
    }
}

// ── Report ──────────────────────────────────────────────────────────────────

if (!$quiet) {
    foreach ($warnings as $line) {
        fwrite(STDOUT, "  ! " . $line . "\n");
    }
    foreach ($problems as $line) {
        fwrite(STDERR, "  ✗ " . $line . "\n");
    }

    fwrite(
        $problems === [] ? STDOUT : STDERR,
        $problems === []
            ? sprintf(
                "doctor: ok (%d pages, %d globals, %d locales, %d components, %d warnings)\n",
                array_sum(array_map(static fn (array $s): int => count($s['routable']), $byLocale)),
                array_sum(array_map(static fn (array $s): int => count($s['globals']), $byLocale)),
                count($byLocale),
                count($types),
                count($warnings)
            )
            : sprintf("doctor: %d problem(s)\n", count($problems))
    );
}

exit($problems === [] ? 0 : 1);
