{
    "name": "dopamine/flatcms",
    "description": "Flat-file CMS for small client sites. Locked components, text-only editing, Cloudflare Access auth, R2 media, edge cache purge.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-exif": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "firebase/php-jwt": "^7.0",
        "symfony/dotenv": "^8.1",
        "symfony/html-sanitizer": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/mailer": "^8.1",
        "symfony/yaml": "^7.2",
        "twig/twig": "^3.21"
    },
    "autoload": {
        "psr-4": {
            "Dopamine\\FlatCms\\": "src/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
