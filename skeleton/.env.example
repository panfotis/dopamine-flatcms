APP_ENV=dev
SITE_BASE_URL=https://dopamine-flatcms-site.ddev.site
AUTH_MODE=cf_access
AUTH_DEV_BYPASS=0
CF_ACCESS_TEAM_DOMAIN=change-me.cloudflareaccess.com
CF_ACCESS_AUD=
ADMIN_LOCALE=en
FORM_TO=
FORM_FROM=
MAIL_DSN=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Optional: R2 media storage. Off by default — uploads live in content/uploads/
# and are committed to git with the content. Flip on for media-heavy sites.
#R2_ENABLED=1
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=
#R2_PUBLIC_BASE=

# Optional: purge the Cloudflare edge cache on save (recommended in production
# together with the cache rules from the engine README's "Cloudflare setup").
#CF_PURGE_ENABLED=1
#CF_ZONE_ID=
#CF_API_TOKEN=
#CF_PURGE_STRATEGY=tag
