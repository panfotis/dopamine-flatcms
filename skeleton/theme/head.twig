{# The <head>, in one file because every layout needs the identical one.

   Included rather than copied into each layout: a tracking tag, a Search
   Console meta or an og: tag added here reaches every page there will ever be,
   including bare.twig — the landing-page and thank-you-page layout, which is
   exactly where a forgotten tag costs money and reports nothing.

   `include` rather than inheritance on purpose: it has no override surface, so
   no layout can silently replace part of what the document says about itself.
   That was the divergence the two copies were guarding against. #}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{# Name only, never a version. The name is how a site gets counted by
   BuiltWith and Wappalyzer, which is the entire point of publishing it. A
   version number is something else: it turns the tag into a filter for
   "which installs are on the release with the known hole", which is why every
   WordPress hardening guide starts by removing theirs. If you ever want to
   know which client is behind, ask the panel, not the public HTML.

   Delete this line on a site whose client would rather not say. #}
<meta name="generator" content="Dopamine FlatCMS">
{#
  Everything here comes from the page's `seo:` map, resolved by Cms::seo() —
  which is where the fallbacks live, so nothing below has to branch on an empty
  value that has a perfectly good default sitting one key away.
#}
<title>{{ page.seo.title }} — {{ site('name') }}</title>
{% if page.seo.description %}<meta name="description" content="{{ page.seo.description }}">{% endif %}
{% if page.seo.noindex %}<meta name="robots" content="noindex, nofollow">{% endif %}
{% if page.seo.canonical %}<link rel="canonical" href="{{ page.seo.canonical }}">{% endif %}
<meta property="og:type" content="website">
<meta property="og:title" content="{{ page.seo.title }}">
<meta property="og:url" content="{{ page.seo.url }}">
{% if page.seo.description %}<meta property="og:description" content="{{ page.seo.description }}">{% endif %}
{# No og:image:alt — the share image is declared decorative, and the card
   already carries the title and description as text beside it. #}
{% if page.seo.og_image.src %}
<meta property="og:image" content="{{ page.seo.og_image.src }}">
<meta name="twitter:card" content="summary_large_image">
{% endif %}
{% if site('favicon') %}<link rel="icon" href="{{ site('favicon') }}">{% endif %}
{# Absolute, because a hreflang a crawler cannot resolve is worse than none —
   and only for languages that actually have this page, since pointing at a
   home page as the "alternate" of a subpage is a claim that is not true.
   A single-language site emits one self-referencing link, which is the valid
   shape for a group of one rather than a placeholder. #}
{% for alt in alternates|default([])|filter(a => not a.missing) %}
<link rel="alternate" hreflang="{{ alt.locale }}" href="{{ alt.abs }}">
{% if alt.default and alternates|length > 1 %}<link rel="alternate" hreflang="x-default" href="{{ alt.abs }}">{% endif %}
{% endfor %}
{{ theme_head() }}
